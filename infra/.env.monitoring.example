# Grafana (infra/monitoring.yml) -> copy to infra/.env.monitoring
#
# Bearer token Grafana sends to tdr-bot's POST /alerts/grafana webhook.
# Must be the same value as GRAFANA_WEBHOOK_TOKEN in apps/tdr-bot/.env.prod.
# Generate with: openssl rand -hex 32
# Must be set: if it is empty or missing, the tdr-bot-alerts contact point is
# provisioned with an empty credential and tdr-bot rejects every alert.
# Grafana 13.1 does NOT log an error for this; it fails silently, so check
# tdr-bot's logs for 401s if alerts stop arriving.
GRAFANA_WEBHOOK_TOKEN=
