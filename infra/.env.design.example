# Open Design (https://github.com/nexu-io/open-design)

# Required. Bearer token the daemon enforces on non-browser /api callers
# (browser calls from OD_ALLOWED_ORIGINS are trusted via Origin match).
# Generate with: openssl rand -hex 32
OD_API_TOKEN=

# Optional. Only needed if you use Open Design's built-in AI agent/chat
# features. Leave blank to skip.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
