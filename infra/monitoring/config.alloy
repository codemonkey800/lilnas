// Ships two sources to Loki: every Docker container's output, and the host's
// systemd journal. Labels, queries and retention are in docs/logging.md.

discovery.docker "containers" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "15s"
}

discovery.relabel "containers" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "compose_project"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.docker.containers.targets
	relabel_rules = discovery.relabel.containers.rules
	forward_to    = [loki.process.containers.receiver]
}

loki.process "containers" {
	stage.json {
		expressions = {
			level  = "level",
			logger = "context",
		}
	}

	stage.labels {
		values = {
			level  = "",
			logger = "",
		}
	}

	// Traefik writes its own messages and the access log to the same stream.
	// Access log lines are the JSON ones carrying a RequestHost field.
	stage.match {
		selector = "{service=\"traefik\"} |= \"\\\"RequestHost\\\"\""

		stage.static_labels {
			values = {
				log_type = "access",
			}
		}

		// Query strings carry secrets (SABnzbd apikey, Emby api_key, OAuth
		// code, S3 presigned signatures). Mask the values before they reach
		// Loki. Traefik's JSON encoder writes "&" as "&", hence u0026.
		stage.replace {
			expression = "(?i)(?:[?&]|u0026)(?:apikey|api_key|access_token|refresh_token|id_token|token|code|key|password|secret|signature|sig|x-amz-signature|x-amz-credential|x-amz-security-token|x-emby-token)=([^&\"\\\\\\s]+)"
			replace    = "REDACTED"
		}
	}

	forward_to = [loki.write.default.receiver]
}

// Host journal. Docker containers log to json-file, not journald, so this is
// host services only and does not duplicate the block above.
loki.relabel "journal" {
	forward_to = []

	// Drop the nexus-code daemon's own output. It runs as a user unit, writes
	// about 80% of the journal, and its monitoring was removed on purpose.
	// Everything else in a user session is kept, including sudo run from a
	// terminal the daemon spawned.
	rule {
		source_labels = ["__journal__systemd_user_unit", "__journal_syslog_identifier"]
		separator     = ";"
		regex         = "nexus-code-daemon-[^;]*;node"
		action        = "drop"
	}

	// Program name: sshd-session, sudo, sshguard, dockerd, kernel. Used instead
	// of the systemd unit because sudo and login messages are filed under a
	// per-session scope unit (session-123.scope), which would make a new Loki
	// stream for every login.
	rule {
		source_labels = ["__journal_syslog_identifier"]
		target_label  = "identifier"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}
}

loki.source.journal "host" {
	path = "/var/log/journal"
	// How far back to read on the very first start. After that Alloy resumes
	// from its saved cursor.
	max_age       = "72h"
	relabel_rules = loki.relabel.journal.rules
	labels        = {
		job     = "journal",
		service = "host",
	}
	forward_to = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
