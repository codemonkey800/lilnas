{
  "id": null,
  "uid": "lilnas-tdr-bot",
  "title": "TDR Bot",
  "tags": ["lilnas", "tdr-bot", "discord", "llm"],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "timezone": "browser",
  "links": [
    {
      "title": "lilnas dashboards",
      "type": "dashboards",
      "tags": ["lilnas"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "requestId",
        "label": "Request ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Summary",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Messages Received",
      "description": "Discord messages that matched a handler, over the selected time range.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(tdr_bot_messages_received_total[$__range])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "LLM Success Rate",
      "description": "Share of LLM requests (graph invocations) that succeeded over the selected time range. Shows 100% when there were no requests.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(tdr_bot_llm_requests_total{status=\"success\"}[$__range])) / sum(increase(tdr_bot_llm_requests_total[$__range])) * 100 or vector(100)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "green",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "LLM Cost",
      "description": "Estimated LLM spend in USD over the selected time range.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(tdr_bot_llm_cost_usd_total[$__range])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "LLM Cost (30d)",
      "description": "Estimated LLM spend in USD over the last 30 days, whatever the time range.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(increase(tdr_bot_llm_cost_usd_total[30d])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Errors",
      "description": "Failed messages, LLM request errors, image generation errors and response failures (fallback or error replies) added up over the selected time range.",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "(sum(increase(tdr_bot_messages_handled_total{status=\"error\"}[$__range])) or vector(0)) + (sum(increase(tdr_bot_llm_requests_total{status=\"error\"}[$__range])) or vector(0)) + (sum(increase(tdr_bot_image_generations_total{status=\"error\"}[$__range])) or vector(0)) + (sum(increase(tdr_bot_responses_sent_total{status=~\"fallback|error\"}[$__range])) or vector(0))",
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Cost",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM Cost per Day by Model",
      "description": "Estimated USD spend per day, stacked by model.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1d",
      "targets": [
        {
          "expr": "sum by (model) (increase(tdr_bot_llm_cost_usd_total[1d]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["sum"]
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Tokens per Day by Model and Type",
      "description": "Tokens per day, stacked by model and type (input, output, cached).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1d",
      "targets": [
        {
          "expr": "sum by (model, type) (increase(tdr_bot_llm_tokens_by_model_total[1d]))",
          "legendFormat": "{{model}} {{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["sum"]
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Latency",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "LLM Request Duration by Skill (p50, p95)",
      "description": "Event-driven: a point appears only when a skill handled a request in the preceding day; each point is a rolling 1-day quantile evaluated hourly. Lines join the points across quiet hours.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1h",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, skill) (increase(tdr_bot_llm_request_duration_seconds_bucket[1d])))",
          "legendFormat": "{{skill}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, skill) (increase(tdr_bot_llm_request_duration_seconds_bucket[1d])))",
          "legendFormat": "{{skill}} p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "LLM Call Duration by Operation (p95)",
      "description": "Event-driven: a point appears only when an operation made an LLM call in the preceding day; each point is a rolling 1-day p95 evaluated hourly.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1h",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (increase(tdr_bot_llm_call_duration_seconds_bucket[1d])))",
          "legendFormat": "{{operation}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Errors",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "collapsed": false
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Failed Messages and LLM Errors",
      "description": "Event-driven: bars appear only on a day a handler failed a message or an LLM request ended in error. The LLM errors series is zero otherwise.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1d",
      "targets": [
        {
          "expr": "sum by (handler) (increase(tdr_bot_messages_handled_total{status=\"error\"}[1d]))",
          "legendFormat": "{{handler}} message errors",
          "refId": "A"
        },
        {
          "expr": "sum(increase(tdr_bot_llm_requests_total{status=\"error\"}[1d])) or vector(0)",
          "legendFormat": "LLM request errors",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["sum"]
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "LLM Call Timeouts, Schema Failures and Retries",
      "description": "Event-driven: bars appear only on a day an LLM call errored or timed out, a structured-output schema check failed, or a call was retried. Schema failures read zero until the first one.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "1d",
      "targets": [
        {
          "expr": "sum by (operation, status) (increase(tdr_bot_llm_calls_total{status=~\"error|timeout\"}[1d]))",
          "legendFormat": "{{operation}} {{status}}",
          "refId": "A"
        },
        {
          "expr": "sum(increase(tdr_bot_llm_schema_failures_total[1d])) or vector(0)",
          "legendFormat": "schema failures",
          "refId": "B"
        },
        {
          "expr": "sum by (reason) (increase(tdr_bot_llm_retries_total[1d]))",
          "legendFormat": "retries ({{reason}})",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["sum"]
        }
      }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Logs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "collapsed": false
    },
    {
      "id": 17,
      "type": "logs",
      "title": "Errors and Warnings",
      "description": "Event-driven: lines appear only when tdr-bot logs at warn (40), error (50) or fatal (60). tdr-bot logs pino JSON, so the Loki level label is numeric.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service=\"tdr-bot\", level=~\"40|50|60|warn|warning|error|fatal\"} |= \"$requestId\"",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 18,
      "type": "logs",
      "title": "Recent TDR Bot Logs",
      "description": "tdr-bot container output, filtered by the Request ID variable. Prometheus scrape requests (/metrics) are left out.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service=\"tdr-bot\"} != \"\\\"url\\\":\\\"/metrics\\\"\" |= \"$requestId\"",
          "refId": "A"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "sortOrder": "Descending"
      }
    }
  ]
}
