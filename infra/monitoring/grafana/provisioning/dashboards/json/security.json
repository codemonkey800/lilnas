{
  "uid": "lilnas-security",
  "id": null,
  "title": "Security",
  "tags": ["lilnas", "security"],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "timezone": "browser",
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "tags": ["lilnas"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ip",
        "type": "textbox",
        "label": "IP",
        "description": "Event-driven: type an address to fill the \"Everything this IP did\" panel at the bottom",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "SSH",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Accepted logins",
      "description": "Event-driven: fills when someone signs in over SSH (Accepted publickey/password lines from sshd). A quiet window shows 0.",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"host\", identifier=~\"sshd|sshd-session\"} |= \"Accepted\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed attempts",
      "description": "Invalid user, Failed password and \"not allowed because not listed in AllowUsers\" lines from sshd over the selected range. Each attempt is counted once; the \"Connection closed by invalid user\" follow-up lines are only in the time series.",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"host\", identifier=~\"sshd|sshd-session\"} |~ \"Invalid user|Failed password|not allowed because\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Accepted SSH logins",
      "description": "Event-driven: one line per successful SSH login: user, auth method and source IP. The key fingerprint is dropped.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service=\"host\", identifier=~\"sshd|sshd-session\"} |= \"Accepted\" | regexp \"Accepted (?P<method>\\\\S+) for (?P<user>\\\\S+) from (?P<ip>\\\\S+) port\" | line_format \"{{.user}} via {{.method}} from {{.ip}}\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": false,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Failed SSH attempts",
      "description": "Event-driven: sshd rejections per interval; empty while nobody is probing. Password login is off, so most of this is bots probing user names.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"host\", identifier=~\"sshd|sshd-session\"} |= \"Invalid user\" [$__interval]))",
          "refId": "A",
          "legendFormat": "Invalid user"
        },
        {
          "expr": "sum(count_over_time({service=\"host\", identifier=~\"sshd|sshd-session\"} |= \"Failed password\" [$__interval]))",
          "refId": "B",
          "legendFormat": "Failed password"
        },
        {
          "expr": "sum(count_over_time({service=\"host\", identifier=~\"sshd|sshd-session\"} |~ \"Connection closed by (invalid|authenticating) user\" [$__interval]))",
          "refId": "C",
          "legendFormat": "Closed by invalid/authenticating user"
        },
        {
          "expr": "sum(count_over_time({service=\"host\", identifier=~\"sshd|sshd-session\"} |= \"not allowed because\" [$__interval]))",
          "refId": "D",
          "legendFormat": "User not in AllowUsers"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["sum"]
        }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Top source IPs (failed attempts)",
      "description": "The 20 addresses with the most failed SSH attempts over the selected range (local ::1 excluded).",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "topk(20, sum by (ip) (count_over_time({service=\"host\", identifier=~\"sshd|sshd-session\"} |~ \"Invalid user|Failed password|Connection closed by (invalid|authenticating) user|not allowed because\" | regexp \" (?P<ip>(?:\\\\d{1,3}\\\\.){3}\\\\d{1,3}|[0-9a-fA-F:]*:[0-9a-fA-F:]+) port \\\\d+\" | ip != \"\" | ip != \"::1\" [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "{{ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "noValue": "none",
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "namePlacement": "left",
        "sizing": "auto"
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Top usernames tried",
      "description": "The 20 user names bots tried most over the selected range. The real account (jeremy) is excluded so local pre-auth drops do not show up.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "topk(20, sum by (user) (count_over_time({service=\"host\", identifier=~\"sshd|sshd-session\"} |~ \"Invalid user|Failed password|Connection closed by (invalid|authenticating) user|not allowed because\" | regexp \"(?:Invalid user|Failed password for (?:invalid user )?|by (?:invalid|authenticating) user|User) ?(?P<user>[^ ]+) (?:from )?(?:(?:\\\\d{1,3}\\\\.){3}\\\\d{1,3}|[0-9a-fA-F:]*:[0-9a-fA-F:]+)\" | user != \"\" | user != \"jeremy\" [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "{{user}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "noValue": "none",
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "namePlacement": "left",
        "sizing": "auto"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "sshguard",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "collapsed": false
    },
    {
      "id": 9,
      "type": "stat",
      "title": "sshguard attacks",
      "description": "sshguard attack detections (each failed login pattern) over the selected range.",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
