    },
    {
      "id": 20,
      "type": "bargauge",
      "title": "Top paths by 4xx/5xx (first segment)",
      "description": "The 20 first path segments (for example /api or /.env) with the most 4xx/5xx responses over the selected range, for requests that matched a Traefik router. Requests for unknown hostnames are in Errors by hostname. Only the first segment and no query string is kept: full paths exceed Loki's 500-series limit at 7 days.",
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 58
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "topk(20, sum by (path) (count_over_time({service=\"traefik\", log_type=\"access\"} |~ \"\\\"DownstreamStatus\\\":[45]\\\\d\\\\d\" |~ \"\\\"RouterName\\\":\" | regexp \"\\\"RequestPath\\\":\\\"(?P<path>/[^/?\\\"]*)\" [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "{{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "noValue": "none",
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "maxVizHeight": 300,
        "minVizHeight": 16,
        "namePlacement": "left",
        "sizing": "auto"
      }
    },
