      "targets": [
        {
          "expr": "sum(count_over_time({service=\"host\", identifier=\"sshguard\"} |= \"Attack from\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "steps": [
              {
                "color": "yellow",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "sshguard blocks",
      "description": "Event-driven: fills when sshguard blocks an address after repeated attacks. A quiet window shows 0.",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"host\", identifier=\"sshguard\"} |= \"Blocking\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "thresholds": {
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "sshguard attacks and blocks",
      "description": "Event-driven: Attacks are sshguard's detections (each failed pattern scores danger points); Blocks appear only when an address crosses the threshold and is put in the nft set. Blocks can be empty in a quiet window.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"host\", identifier=\"sshguard\"} |= \"Attack from\" [$__interval]))",
          "refId": "A",
          "legendFormat": "Attacks"
        },
        {
          "expr": "sum(count_over_time({service=\"host\", identifier=\"sshguard\"} |= \"Blocking\" [$__interval]))",
          "refId": "B",
          "legendFormat": "Blocks"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Attacks"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Blocks"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["sum"]
        }
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Blocked IPs",
      "description": "Event-driven: addresses sshguard blocked in the selected range, with how many times. Empty when nothing was blocked.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "topk(20, sum by (ip) (count_over_time({service=\"host\", identifier=\"sshguard\"} |= \"Blocking\" | regexp \"Blocking \\\"(?P<ip>[^\\\"/]+)\" [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "{{ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "none",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Blocks",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "mode": "seriesToRows",
            "reducers": ["lastNotNull"],
            "includeTimeField": false,
            "labelsToFields": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Field": true
            },
            "indexByName": {
              "ip": 0,
              "Last *": 1
            },
            "renameByName": {
              "Last *": "Blocks"
            }
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "row",
      "title": "sudo",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "collapsed": false
    },
