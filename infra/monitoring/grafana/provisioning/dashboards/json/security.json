    {
      "id": 15,
      "type": "stat",
      "title": "Sudo failures",
      "description": "Event-driven: fills when a sudo attempt needs a password that was not supplied (\"a password is required\") or the wrong one was typed (\"incorrect password\"). A quiet window shows 0.",
      "gridPos": {
        "h": 4,
        "w": 12,
