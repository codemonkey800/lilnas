    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "4xx and 5xx over time",
      "description": "Requests through Traefik that were answered with a client (4xx) or server (5xx) error. Includes scanners, rejected logins at lilnas-auth and unknown hostnames.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service=\"traefik\", log_type=\"access\"} |~ \"\\\"DownstreamStatus\\\":4\\\\d\\\\d\" [$__interval]))",
          "refId": "A",
          "legendFormat": "4xx"
        },
        {
          "expr": "sum(count_over_time({service=\"traefik\", log_type=\"access\"} |~ \"\\\"DownstreamStatus\\\":5\\\\d\\\\d\" [$__interval]))",
          "refId": "B",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
