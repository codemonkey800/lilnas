          "placement": "bottom",
          "calcs": ["sum"]
        }
      }
    },
    {
      "id": 19,
      "type": "bargauge",
      "title": "Top 20 client IPs by 4xx/5xx",
      "description": "The 20 client addresses with the most 4xx/5xx responses over the selected range.",
      "gridPos": {
