          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Event Loop Lag",
      "description": "Event loop lag: latest sample and the 99th percentile over the prom-client collection window.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_seconds{job=\"$app\"}",
          "legendFormat": "Lag",
          "refId": "A"
        },
        {
          "expr": "nodejs_eventloop_lag_p99_seconds{job=\"$app\"}",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
