{
  "uid": "lilnas-overview",
  "id": null,
  "title": "Overview",
  "description": "One screen: does anything need attention? Each panel links to the dashboard that explains it.",
  "tags": ["lilnas", "overview"],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "links": [
    {
      "title": "lilnas dashboards",
      "type": "dashboards",
      "tags": ["lilnas"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": false
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scrape targets up / total",
      "description": "Prometheus scrape targets that answered the last scrape, and how many exist. A target that is down is listed in the table to the right.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Open Infrastructure",
          "url": "/d/lilnas-infrastructure"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(up) or vector(0)",
          "legendFormat": "up"
        },
        {
          "refId": "B",
          "instant": true,
          "expr": "count(up) or vector(0)",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Infrastructure",
              "url": "/d/lilnas-infrastructure"
            }
          ],
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scrape targets down",
      "description": "Scrape targets with up == 0. Green only at 0.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 4,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Open Infrastructure",
          "url": "/d/lilnas-infrastructure"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "count(up == 0) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Infrastructure",
              "url": "/d/lilnas-infrastructure"
            }
          ],
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Targets that are down",
      "description": "Event-driven: has rows only while a scrape target is down (up == 0); shows \"none\" otherwise.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 7,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Open Infrastructure",
          "url": "/d/lilnas-infrastructure"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "up == 0",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Infrastructure",
              "url": "/d/lilnas-infrastructure"
            }
          ],
          "noValue": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true
            },
            "indexByName": {
              "job": 0,
              "instance": 1
            },
            "renameByName": {
              "job": "Job",
              "instance": "Instance"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Btrfs device errors",
      "description": "Sum of every btrfs device error counter (read, write, flush, corruption, generation). Green only at 0.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 13,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Open Storage",
          "url": "/d/lilnas-storage"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(node_btrfs_device_errors_total) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Storage",
              "url": "/d/lilnas-storage"
            }
          ],
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Days to certificate expiry",
      "description": "Days until the soonest Traefik certificate expires. Red under 14, orange under 30.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Open Traefik",
          "url": "/d/lilnas-traefik"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "min(traefik_tls_certs_not_after - time()) / 86400 or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Traefik",
              "url": "/d/lilnas-traefik"
            }
          ],
          "unit": "d",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 14
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Containers running",
      "description": "Containers cAdvisor has seen in the last minute.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Open App detail",
          "url": "/d/lilnas-app-detail"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "count(time() - container_last_seen{name!=\"\"} < 60) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open App detail",
              "url": "/d/lilnas-app-detail"
            }
          ],
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Drives failing SMART",
      "description": "Drives whose SMART overall health check reports failed (smartctl_device_smart_status == 0), out of every SATA and NVMe drive smartctl-exporter sees. Green only at 0.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Open Disk health",
          "url": "/d/lilnas-disk-health"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "count(smartctl_device_smart_status == 0) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Disk health",
              "url": "/d/lilnas-disk-health"
            }
          ],
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Bad sectors + media errors",
      "description": "Reallocated plus pending sectors (raw SATA attributes) plus NVMe media and data integrity errors, summed over all drives. Green only at 0.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Open Disk health",
          "url": "/d/lilnas-disk-health"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "(sum(smartctl_device_attribute{attribute_name=~\"Reallocated_Sector_Ct|Current_Pending_Sector\",attribute_value_type=\"raw\"}) or vector(0)) + (sum(smartctl_device_media_errors) or vector(0))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Disk health",
              "url": "/d/lilnas-disk-health"
            }
          ],
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Hottest drive",
      "description": "Highest current temperature across all drives. Orange from 55 °C, red from 65 °C.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Open Disk health",
          "url": "/d/lilnas-disk-health"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "max(smartctl_device_temperature{temperature_type=\"current\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Disk health",
              "url": "/d/lilnas-disk-health"
            }
          ],
          "unit": "celsius",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 55
              },
              {
                "color": "red",
                "value": 65
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Postgres servers up",
      "description": "Postgres servers answering their exporter (pg_up by server), out of the 3 monitored: tdr-bot-db, icloud-backup-db and immich-database. Green only at 3.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Open Postgres",
          "url": "/d/lilnas-postgres"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(pg_up) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Postgres",
              "url": "/d/lilnas-postgres"
            }
          ],
          "unit": "suffix: / 3",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          },
          "max": 3
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Media exporters up",
      "description": "Sonarr, Radarr and SABnzbd exporters (exportarr) that answered the last scrape, out of 3. Green only at 3.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Open Media",
          "url": "/d/lilnas-media"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(up{job=~\"sonarr|radarr|sabnzbd\"}) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Media",
              "url": "/d/lilnas-media"
            }
          ],
          "unit": "suffix: / 3",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          },
          "max": 3
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 25,
      "type": "stat",
      "title": "Download queue",
      "description": "Items in the SABnzbd download queue.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Open Media",
          "url": "/d/lilnas-media"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(sabnzbd_queue_length) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Media",
              "url": "/d/lilnas-media"
            }
          ],
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Disk fill per btrfs mount",
      "description": "Percent used of each btrfs mount, named by the lilnas_storage_volume label. Orange at 80%, red at 90%.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Open Storage",
          "url": "/d/lilnas-storage"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sort_desc(((1 - node_filesystem_avail_bytes{fstype=\"btrfs\"} / node_filesystem_size_bytes{fstype=\"btrfs\"}) * 100) * on(mountpoint) group_left(volume) lilnas_storage_volume or on(mountpoint) label_replace(((1 - node_filesystem_avail_bytes{fstype=\"btrfs\"} / node_filesystem_size_bytes{fstype=\"btrfs\"}) * 100), \"volume\", \"$1\", \"mountpoint\", \"(.*)\"))",
          "legendFormat": "{{volume}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Storage",
              "url": "/d/lilnas-storage"
            }
          ],
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "minVizHeight": 12,
        "text": {}
      }
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Container restarts in 24h",
      "description": "Event-driven: has bars only when a container started again in the last 24 hours; shows \"none\" otherwise. A deploy recreates containers, so every service a deploy touched shows 1 here.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 8,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Open App detail",
          "url": "/d/lilnas-app-detail"
        },
        {
          "title": "Open Logs",
          "url": "/d/lilnas-logs"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "topk(10, changes(container_start_time_seconds{name!=\"\"}[24h]) > 0)",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open App detail",
              "url": "/d/lilnas-app-detail"
            },
            {
              "title": "Open Logs",
              "url": "/d/lilnas-logs"
            }
          ],
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "noValue": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "yellow",
                "value": null
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "minVizHeight": 12,
        "text": {}
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Top services by 5xx (24h)",
      "description": "Event-driven: has bars only when Traefik returned a 5xx in the last 24 hours; shows \"none\" otherwise. Counted from traefik_service_requests_total.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 14,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "links": [
        {
          "title": "Open Traefik",
          "url": "/d/lilnas-traefik"
        },
        {
          "title": "Open Logs",
          "url": "/d/lilnas-logs"
        }
      ],
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "topk(10, sum by (service) (increase(traefik_service_requests_total{code=~\"5..\"}[24h])) > 0)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open Traefik",
              "url": "/d/lilnas-traefik"
            },
            {
              "title": "Open Logs",
              "url": "/d/lilnas-logs"
            }
          ],
