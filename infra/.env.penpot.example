# Penpot (https://penpot.app) — see infra/penpot.yml

# Required. Master key Penpot derives session/invitation keys from.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=

# Required. Postgres password — both values must match.
# Generate with: openssl rand -hex 32
PENPOT_DATABASE_PASSWORD=
POSTGRES_PASSWORD=

# Required. OIDC client secret for lilnas-auth. Must equal
# OIDC_PENPOT_CLIENT_SECRET in apps/auth/.env.prod.
# Generate with: openssl rand -hex 32
PENPOT_OIDC_CLIENT_SECRET=
