{
  "name": "@lilnas/me-token-tracker",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "packageManager": "pnpm@12.14.0",
  "prettier": "@lilnas/prettier",
  "files": [
    "./dist"
  ],
  "scripts": {
    "build": "nest build -b swc --type-check",
    "clean": "rm -rf dist/ .turbo/",
    "dev": "nest start -w -b swc | pino-pretty",
    "lint": "run-p -l 'lint:!(fix)'",
    "lint:eslint": "eslint src",
    "lint:prettier": "prettier -c src",
    "lint:fix": "run-p -l lint:*:fix",
    "lint:eslint:fix": "eslint --fix src",
    "lint:prettier:fix": "prettier -w src",
    "start": "NODE_ENV=production node dist/main",
    "type-check": "tsc7 --noEmit"
  },
  "devDependencies": {
    "@lilnas/cli": "workspace:*"
  },
  "dependencies": {
    "@lilnas/utils": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/schedule": "12.0.2",
    "@prometheus-io/client": "^0.16.1",
    "@willsoto/nestjs-prometheus": "^7.0.0",
    "axios": "1.20.0",
    "coingecko-api-v3": "0.0.31",
    "dedent": "1.7.2",
    "discord.js": "14.27.0",
    "dotenv": "17.2.3",
    "http-server": "14.1.1",
    "necord": "7.0.0",
    "nestjs-pino": "5.3.1",
    "npm-run-all": "4.1.5",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "source-map-support": "0.5.21",
    "ts-pattern": "5.9.2"
  }
}
