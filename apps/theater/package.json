{
  "name": "@lilnas/theater",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "packageManager": "pnpm@12.14.0",
  "prettier": "@lilnas/prettier",
  "files": [
    "./.next",
    "./dist"
  ],
  "scripts": {
    "build": "run-p build:*",
    "build:backend": "nest build -b swc --type-check",
    "build:frontend": "next build",
    "clean": "rm -rf .next/ dist/ .turbo/",
    "convert": "tsx scripts/convert.ts",
    "dev": "run-p dev:backend dev:frontend",
    "dev:backend": "nest start -w -b swc | pino-pretty",
    "dev:frontend": "next dev -p ${FRONTEND_PORT:-8080}",
    "lint": "run-p -l 'lint:!(fix)'",
    "lint:eslint": "eslint src scripts",
    "lint:prettier": "prettier -c src scripts",
    "lint:fix": "run-p -l lint:*:fix",
    "lint:eslint:fix": "eslint --fix src scripts",
    "lint:prettier:fix": "prettier -w src scripts",
    "seats": "tsx scripts/seats.ts",
    "start": "run-p start:*",
    "start:backend": "node dist/main",
    "start:frontend": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "type-check": "run-p type-check:*",
    "type-check:app": "tsc --noEmit",
    "type-check:scripts": "tsc -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@lilnas/utils": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/platform-socket.io": "11.1.6",
    "@nestjs/throttler": "6.4.0",
    "@nestjs/websockets": "11.1.6",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@react-three/rapier": "2.2.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "clsx": "2.1.1",
    "cookie": "1.1.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "ecctrl": "1.0.97",
    "hls.js": "1.6.16",
    "leva": "0.10.1",
    "nestjs-pino": "4.4.1",
    "next": "15.5.20",
    "npm-run-all": "4.1.5",
    "pino-http": "11.0.0",
    "prom-client": "^15.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "4.8.3",
    "socket.io-client": "4.8.3",
    "source-map-support": "0.5.21",
    "tailwind-merge": "3.3.1",
    "three": "0.185.1",
    "three-stdlib": "2.36.1",
    "zod": "4.1.12",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@lilnas/cli": "workspace:*",
    "@types/cookie-parser": "1.4.9",
    "@types/jest": "30.0.0",
    "@types/three": "0.185.1",
    "jest": "30.5.2",
    "ts-jest": "29.4.15",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
