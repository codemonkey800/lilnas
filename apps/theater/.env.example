# Copy this file to .env and customize as needed.
# .env is gitignored; this example file is committed.

# App specific
BACKEND_PORT=8081
FRONTEND_PORT=8080
TZ=America/Los_Angeles

# Shared password gate for the landing page.
THEATER_PASSWORD=change-me

# Secret used to sign the session cookie. Generate with:
#   openssl rand -hex 32
THEATER_SESSION_SECRET=change-me

# API key for the Emby server (Settings > API Keys in Emby dashboard).
EMBY_API_KEY=change-me

# Base URL of the Emby server, with NO trailing slash, e.g. https://emby.lilnas.io
EMBY_URL=change-me

# Emby username (the exact `Name` field returned by Emby's /Users endpoint —
# not necessarily a "display name") whose permissions/context playback
# resolution runs under.
EMBY_USERNAME=change-me

# Where the browser connects the multiplayer Socket.IO client. In dev, the
# frontend (FRONTEND_PORT) and backend (BACKEND_PORT) are different ports, so
# this must point at the backend directly. In prod, leave unset — Traefik
# routes /socket.io to the backend on the same origin as the page
# (deploy.yml), so the client should connect same-origin instead.
NEXT_PUBLIC_SOCKET_URL=http://localhost:8081

# Optional comma-separated STUN server(s) for voice chat's WebRTC connections; defaults to a public STUN server when unset.
NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
