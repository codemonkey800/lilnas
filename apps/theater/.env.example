# Copy this file to .env and customize as needed.
# .env is gitignored; this example file is committed.

# App specific
BACKEND_PORT=8081
FRONTEND_PORT=8080
TZ=America/Los_Angeles

# Shared password gate for the landing page.
THEATER_PASSWORD=change-me

# Secret used to sign the session cookie. Generate with:
#   openssl rand -hex 32
THEATER_SESSION_SECRET=change-me

# API key for the Emby server (Settings > API Keys in Emby dashboard).
EMBY_API_KEY=change-me

# Base URL of the Emby server, with NO trailing slash, e.g. https://emby.lilnas.io
EMBY_URL=change-me

# Emby username (the exact `Name` field returned by Emby's /Users endpoint —
# not necessarily a "display name") whose permissions/context playback
# resolution runs under.
EMBY_USERNAME=change-me
