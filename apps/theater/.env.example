# Copy this file to .env and customize as needed.
# .env is gitignored; this example file is committed.

# App specific
BACKEND_PORT=8081
FRONTEND_PORT=8080
TZ=America/Los_Angeles

# Shared password gate for the landing page.
THEATER_PASSWORD=change-me

# Secret used to sign the session cookie. Generate with:
#   openssl rand -hex 32
THEATER_SESSION_SECRET=change-me
