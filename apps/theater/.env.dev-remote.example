# Env for the theater dev container (deploy.dev.yml). Copy to .env.dev-remote
# (gitignored) and fill in the secrets. deploy.dev.yml mounts it over
# apps/theater/.env inside the container, so it wins over the host's
# native-dev .env.

BACKEND_PORT=8081
FRONTEND_PORT=8080
TZ=America/Los_Angeles

# Shared password gate for the landing page.
THEATER_PASSWORD=change-me

# Secret used to sign the session cookie. Generate with:
#   openssl rand -hex 32
THEATER_SESSION_SECRET=change-me

# The container joins lilnas_default, so it reaches Emby by service name. The
# backend proxies every Emby request (including HLS playlists), so the browser
# never needs this URL.
EMBY_URL=http://emby:8096
EMBY_API_KEY=change-me
EMBY_USERNAME=change-me

# Leave NEXT_PUBLIC_SOCKET_URL unset: the page is served from
# theater.dev.lilnas.io and Traefik routes /socket.io on that same origin to
# the backend (deploy.dev.yml's `dev-theater-ws` router).

NEXT_PUBLIC_STUN_URLS=stun:stun.l.google.com:19302
