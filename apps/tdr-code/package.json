{
  "name": "@lilnas/tdr-code",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "packageManager": "pnpm@12.14.0",
  "prettier": "@lilnas/prettier",
  "engines": {
    "node": ">=22.22.1"
  },
  "files": [
    "./.next",
    "./dist"
  ],
  "scripts": {
    "build": "run-s build:frontend build:backend build:info",
    "build:backend": "nest build -b swc --type-check",
    "build:frontend": "next build && cp .next/standalone/apps/tdr-code/server.js server.js",
    "build:info": "git rev-parse HEAD > dist/BUILD_SHA",
    "clean": "rm -rf .next/ dist/ server.js .turbo/",
    "daemon:start": "./scripts/daemon.sh start",
    "daemon:stop": "./scripts/daemon.sh stop",
    "daemon:restart": "./scripts/daemon.sh restart",
    "daemon:status": "./scripts/daemon.sh status",
    "daemon:rebuild": "run-s build daemon:restart",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "dev": "run-p dev:main dev:frontend",
    "dev:main": "nest start -w -b swc | pino-pretty",
    "dev:bot": "node dist/bot-main",
    "dev:frontend": "dotenv run -q -- next dev",
    "lint": "run-p -l 'lint:!(fix)'",
    "lint:eslint": "eslint src",
    "lint:prettier": "prettier -c src",
    "lint:fix": "run-p -l lint:*:fix",
    "lint:eslint:fix": "eslint --fix src",
    "lint:prettier:fix": "prettier -w src",
    "start": "run-p start:main start:frontend",
    "start:main": "node dist/main",
    "start:bot": "node dist/bot-main",
    "start:frontend": "dotenv run -q -- node server.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --watch",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --coverage",
    "type-check": "tsc7 --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.0.0",
    "@better-auth/drizzle-adapter": "1.7.12",
    "@lilnas/utils": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/schedule": "12.0.2",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-virtual": "^3.14.21",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "better-auth": "1.7.12",
    "better-sqlite3": "^13.0.3",
    "clsx": "2.1.1",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.10.2",
    "dayjs": "1.11.23",
    "diff": "^9.0.0",
    "discord.js": "^14.27.0",
    "dotenv": "18.0.8",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "necord": "7.0.0",
    "nestjs-pino": "5.3.1",
    "next": "16.4.2",
    "npm-run-all": "4.1.5",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "smol-toml": "^1.9.1",
    "source-map-support": "0.5.21",
    "sshpk": "^1.18.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lilnas/eslint": "workspace:*",
    "@nestjs/testing": "12.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sshpk": "^1.17.5",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "jest-environment-jsdom": "^30.5.2",
    "msw": "3.0.3",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15"
  }
}
