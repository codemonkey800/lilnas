# Copy this file to .env and customize as needed.
# .env is gitignored; this example file is committed.

# App specific
BACKEND_PORT=8081
DATABASE_PATH=./lilnas-auth.db
FRONTEND_PORT=8080
NODE_ENV=development
TZ=America/Los_Angeles

# -----------------------------------------------------------------------------
# Auth (U3): Google OAuth + Better Auth session config.
#
# AUTH_HOST is a full origin (scheme + host, NO path, NO trailing slash).
# Reused verbatim by U4 (redirect validation's own-host loop guard) and U5
# (absolute Location headers off /verify) — every unit that builds a URL
# against this app's own hostname must agree on this exact shape.
#   dev:  http://auth.localhost
#   prod: set directly in .env.prod on the deploy host (never committed —
#         see root CLAUDE.md's Environment Variables section):
#         https://auth.lilnas.io.
#
# COOKIE_DOMAIN is the `Domain` attribute for the cross-subdomain session
# cookie (advanced.crossSubDomainCookies.domain, R1). Deliberately NOT
# hardcoded to `.lilnas.io` in code, since dev sign-in testing runs on
# `*.localhost`, never `*.lilnas.io`.
#   dev:  .localhost
#   prod: .lilnas.io (set directly in .env.prod)
#
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET come from a Google Cloud OAuth
# client. Both https://login.lilnas.io/api/auth/callback/google and
# https://auth.lilnas.io/api/auth/callback/google were registered as
# authorized redirect URIs up front (plan's Key Technical Decisions), so
# the login→auth hostname rename needed no console round-trip.
#
# BETTER_AUTH_SECRET is a generated session-signing secret, unrelated to
# Google — e.g. `openssl rand -base64 32`.
#
# ADMIN_EMAILS (R17) is NOT added here — it belongs to U7's admin
# authorization guard and to VerifyService's admin bypass on /verify,
# neither of which this unit implements. See the dedicated Admin (U7, R17)
# block further below for both consumers.
# -----------------------------------------------------------------------------
AUTH_HOST=http://auth.localhost
COOKIE_DOMAIN=.localhost
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
BETTER_AUTH_SECRET=changeme

# -----------------------------------------------------------------------------
# Redirect validation (U4): src/auth/redirect.ts's resolveRedirectTarget()
# validates the login page's `?redirect=` query param before using it as a
# post-sign-in destination (R3, AE4) — parse-then-check against a real
# `new URL()`, never a string match.
#
# REDIRECT_ALLOWED_SUFFIX is the domain family a redirect candidate's
# hostname must equal, or be a subdomain of (i.e. end with
# "." + this value — the leading dot matters, see redirect.ts). NOT
# hardcoded in code so *.dev.lilnas.io (docs/lilnas-expose.md) and
# *.localhost each work in their own environment with no code change.
#   dev:  localhost
#   prod: lilnas.io (set directly in .env.prod) — also covers
#         *.dev.lilnas.io, which is already a nested subdomain of lilnas.io.
#
# There is no separate "required scheme" env var. The required scheme is
# DERIVED from AUTH_HOST's own protocol (https:// in prod, http:// in
# dev) — the same pattern src/auth/auth.ts already uses for the Secure
# cookie attribute — so a candidate's scheme must match whatever scheme
# THIS deployment's own AUTH_HOST uses. This is what makes "https-only in
# production" and "http works against *.localhost in dev" both true
# without a second scheme knob to keep in sync with AUTH_HOST.
# -----------------------------------------------------------------------------
REDIRECT_ALLOWED_SUFFIX=localhost

# -----------------------------------------------------------------------------
# Request lifecycle (U6): src/sse/sse.controller.ts's keepalive. There is no
# re-request cooldown (removed post-launch) — signing in again after a
# rejection always starts a fresh request immediately, gated on that
# explicit sign-in click rather than a time window; see
# src/requests/requests.service.ts's own header comment.
#
# SSE_KEEPALIVE_MS is the pending page's live-channel keepalive interval,
# same convention as apps/tdr-code/src/sse/sse.controller.ts's identical var.
# -----------------------------------------------------------------------------
SSE_KEEPALIVE_MS=25000

# -----------------------------------------------------------------------------
# Admin (U7, R17): comma-separated allowlist with TWO independent consumers.
#
# src/admin/admin.guard.ts checks a signed-in session's email against this
# list ALONE for /admin access - it never reads the grants table, so admin
# access can never be revoked by anything in that table (including one
# that's empty or corrupted).
#
# src/verify/verify.service.ts additionally grants an ADMIN_EMAILS address
# unconditional access on /verify to EVERY protected host, with no per-host
# grant required - including while that account is blocked. This is what
# lets an admin skip the normal grant/pending flow entirely for any current
# or future router migration.
#
# Matching is case/whitespace-insensitive in both consumers.
# -----------------------------------------------------------------------------
ADMIN_EMAILS=changeme@example.com
