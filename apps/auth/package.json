{
  "name": "@lilnas/auth",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "packageManager": "pnpm@10.18.2",
  "prettier": "@lilnas/prettier",
  "files": [
    "./.next",
    "./dist"
  ],
  "scripts": {
    "build": "run-s build:frontend build:backend",
    "build:backend": "nest build -b swc --type-check",
    "build:frontend": "next build",
    "clean": "rm -rf .next/ dist/ .turbo/",
    "db:generate": "drizzle-kit generate",
    "dev": "lilnas dev",
    "dev:backend": "nest start -w -b swc | pino-pretty",
    "dev:frontend": "next dev -p 8080",
    "dev:start": "run-p dev:backend dev:frontend",
    "lint": "run-p -l 'lint:!(fix)'",
    "lint:eslint": "eslint src",
    "lint:prettier": "prettier -c src",
    "lint:fix": "run-p -l lint:*:fix",
    "lint:eslint:fix": "eslint --fix src",
    "lint:prettier:fix": "prettier -w src",
    "seed:whitelist": "node dist/db/seed-whitelist.js",
    "start": "run-p --race start:*",
    "start:backend": "node dist/main",
    "start:frontend": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.23",
    "@lilnas/utils": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@thallesp/nestjs-better-auth": "2.6.1",
    "better-auth": "1.6.23",
    "better-sqlite3": "^12.10.0",
    "dotenv": "17.2.3",
    "drizzle-orm": "^0.45.2",
    "next": "15.5.20",
    "nestjs-pino": "4.4.1",
    "npm-run-all": "4.1.5",
    "pino-http": "11.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "source-map-support": "0.5.21",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@lilnas/cli": "workspace:*",
    "@nestjs/testing": "11.1.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "29.5.14",
    "babel-jest": "29.7.0",
    "drizzle-kit": "^0.31.9",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "pino-pretty": "13.1.2",
    "ts-jest": "29.2.6",
    "typescript": "5.9.3"
  }
}
