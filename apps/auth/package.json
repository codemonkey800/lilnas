{
  "name": "@lilnas/auth",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "packageManager": "pnpm@12.14.0",
  "prettier": "@lilnas/prettier",
  "files": [
    "./.next",
    "./dist"
  ],
  "scripts": {
    "build": "run-s build:frontend build:backend",
    "build:backend": "nest build -b swc --type-check",
    "build:frontend": "next build",
    "clean": "rm -rf .next/ dist/ .turbo/",
    "db:generate": "drizzle-kit generate",
    "dev": "run-p dev:backend dev:frontend",
    "dev:backend": "nest start -w -b swc | pino-pretty",
    "dev:frontend": "next dev -p 8080",
    "lint": "run-p -l 'lint:!(fix)'",
    "lint:eslint": "eslint src",
    "lint:prettier": "prettier -c src",
    "lint:fix": "run-p -l lint:*:fix",
    "lint:eslint:fix": "eslint --fix src",
    "lint:prettier:fix": "prettier -w src",
    "start": "run-p --race start:*",
    "start:backend": "node dist/main",
    "start:frontend": "node server.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --watch",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --coverage && node scripts/print-coverage-summary.js",
    "type-check": "tsc7 --noEmit"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.12",
    "@better-auth/oauth-provider": "1.7.12",
    "@better-auth/utils": "0.5.0",
    "@lilnas/utils": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "better-auth": "1.7.12",
    "better-sqlite3": "^13.0.3",
    "dotenv": "18.0.8",
    "drizzle-orm": "^0.45.4",
    "jose": "6.2.13",
    "nestjs-pino": "5.3.1",
    "next": "16.4.2",
    "npm-run-all": "4.1.5",
    "pino-http": "11.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "source-map-support": "0.5.21",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@lilnas/cli": "workspace:*",
    "@nestjs/testing": "12.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "30.0.0",
    "drizzle-kit": "^0.31.11",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "pino-pretty": "13.2.0",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  }
}
