# Port the NestJS backend listens on.
BACKEND_PORT=8081

# Port `next dev` listens on (dev script only).
FRONTEND_PORT=8080

# Postgres (shared by the backend only).
POSTGRES_HOST=icloud-backup-db
POSTGRES_PORT=5432
POSTGRES_USER=icloud_backup
POSTGRES_PASSWORD=
POSTGRES_DB=icloud_backup

# icloudpd: binary, its web UI (loopback only) and an optional `--recent N`
# for dry runs.
ICLOUDPD_BIN=/usr/local/bin/icloudpd
ICLOUDPD_WEBUI_URL=http://127.0.0.1:8080
ICLOUDPD_RECENT=

# Where each person's photos land (host /storage/photos/icloud-users), where
# icloudpd session cookies live (<STATE_ROOT>/cookies/<slug>), and the disk and
# concurrency limits.
PHOTOS_ROOT=/photos
STATE_ROOT=/state
MIN_FREE_BYTES=200000000000
MAX_DOWNLOADS=2

# Immich: container address, API key, public address, and PHOTOS_ROOT as
# Immich sees it.
IMMICH_URL=http://immich:2283
IMMICH_API_KEY=
IMMICH_EXTERNAL_URL=https://immich.lilnas.io
IMMICH_IMPORT_ROOT=/icloud-users

# Dry runs only: a@b.c becomes a+<tag>@b.c, and the folder name gets a prefix.
IMMICH_EMAIL_PLUS_TAG=
ACCOUNT_SLUG_PREFIX=

# Dev-only identity fallback. Ignored when NODE_ENV=production.
DEV_USER_EMAIL=
DEV_USER_ID=
