# Port the NestJS backend listens on.
BACKEND_PORT=8081

# Port `next dev` listens on (dev script only).
FRONTEND_PORT=8080

# Checkout of the lilnas repo the dashboard reads deploy.dev.yml files from.
LILNAS_REPO=/home/jeremy/lilnas

# Directory holding the external dev projects (docker-compose*.yml per subdir).
DEV_PROJECTS_ROOT=/home/jeremy/dev

# Auth service, queried for per-host activity.
AUTH_URL=http://auth:8081

# Hours without a visit before a dev stack counts as idle.
DEFAULT_MAX_IDLE_HOURS=2

# Docker Engine socket and CLI binary.
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_BIN=docker
