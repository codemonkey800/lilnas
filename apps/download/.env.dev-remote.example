# Template for .env.dev-remote — the environment used by deploy.dev.yml,
# which publishes the containerised dev instance at
# https://download.dev.lilnas.io.
#
#   cp .env.dev-remote.example .env.dev-remote   # then fill in the secrets
#
# ⚠️ Why this file exists at all, rather than compose `environment:` entries:
# `pnpm dev` runs `lilnas dev`, which calls Node's loadEnvFile() on
# apps/download/.env (packages/cli/src/commands/dev.ts:48). That OVERRIDES the
# container environment, so values passed via compose lose to whatever is in
# that file. deploy.dev.yml therefore mounts this file over
# apps/download/.env inside the container.
#
# Everything here matches .env except the four upstream URLs and DATABASE_PATH.
# The secrets are identical — copy them across from .env or .env.prod.

# ── App ──────────────────────────────────────────────────────────────────────
# Both servers run inside the one container: Nest on 8081, Next on 8080.
# Traefik routes to 8080; Next's own /api and /ws rewrites reach 8081 in-process,
# so no host port is published and there is no clash with url-shortener-proxy-1,
# which owns host 8080.
BACKEND_PORT=8081
FRONTEND_PORT=8080
MAX_DOWNLOADS=5
TZ=America/Los_Angeles

# ── Upstreams ────────────────────────────────────────────────────────────────
# ⚠️ Service NAMES, not the hardcoded 172.18.x.x IPs .env uses. This container
# is on lilnas_default, so Docker's embedded DNS resolves these — and unlike the
# IPs, they survive an upstream container being recreated.
#
# These must stay internal: lilnas-auth gates the public radarr.lilnas.io and
# sonarr.lilnas.io hostnames with no API-key bypass.
MINIO_HOST=storage
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PUBLIC_URL=https://storage.lilnas.io

RADARR_URL=http://radarr:7878
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

EMBY_URL=http://emby:8096
EMBY_EXTERNAL_URL=https://emby.lilnas.io
EMBY_USERNAME=
EMBY_API_KEY=

# ── Instance ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ⚠️ EPHEMERAL BY DESIGN. /data is a tmpfs declared in deploy.dev-remote.yml, so
# this database is created from scratch on every start and destroyed the moment
# the container stops. Nothing persists between runs and nothing is written to
# disk at all.
#
# An empty file is all that is needed: better-sqlite3 creates it and
# src/db/db.service.ts runs the drizzle migrator at boot, so the schema builds
# itself. Expect empty gallery/history/activity states on a fresh start —
# /search still returns results, because discovery reads Radarr and Sonarr live
# rather than the database.
#
# ⚠️ NEVER point this at /storage/app-data/download/download.db. Production's
# lilnas-download-1 holds that file open, and a second writer on the same WAL
# risks SQLITE_BUSY and can corrupt the live service's data.
DATABASE_PATH=/data/download.db

# Dev-only fallback identity, used ONLY when no X-Forwarded-User header arrives
# (src/auth/forwarded-user.ts reads real headers first). Behind Traefik the
# lilnas-auth middleware supplies a genuine identity, so this applies only to
# direct container-to-container calls on 8081. Must be an address in
# lilnas-auth's ADMIN_EMAILS for the admin surfaces to be reachable.
DEV_USER_EMAIL=
DEV_USER_ID=dev-remote-user
