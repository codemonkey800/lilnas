# Copy this file to .env and customize as needed.
# .env is gitignored; this example file is committed.

# App specific
BACKEND_PORT=8081
DATABASE_PATH=./download.db
FRONTEND_PORT=8080
MAX_DOWNLOADS=5
TZ=America/Los_Angeles

# Dev-only fallback identity — dev has no lilnas-auth, so X-Forwarded-User
# headers never arrive. Set both to exercise attribution locally; point
# DEV_USER_EMAIL at an apps/auth ADMIN_EMAILS address to test the admin
# branch. Leave unset (default) to behave like an anonymous service caller.
# Never set in production.
# DEV_USER_EMAIL=me@lilnas.io
# DEV_USER_ID=dev-user-1

# MinIO
MINIO_ACCESS_KEY=key
MINIO_HOST=host
MINIO_PORT=9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_SECRET_KEY=key

# Radarr / Sonarr
RADARR_API_KEY=key
RADARR_URL=http://localhost:7878
SONARR_API_KEY=key
SONARR_URL=http://localhost:8989
