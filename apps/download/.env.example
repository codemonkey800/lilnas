# Copy this file to .env and customize as needed.
# .env is gitignored; this example file is committed.

# App specific
BACKEND_PORT=8081
DATABASE_PATH=./download.db
FRONTEND_PORT=8080
MAX_DOWNLOADS=5
TZ=America/Los_Angeles

# MinIO
MINIO_ACCESS_KEY=key
MINIO_HOST=host
MINIO_PORT=9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_SECRET_KEY=key

# Radarr / Sonarr
RADARR_API_KEY=key
RADARR_URL=http://localhost:7878
SONARR_API_KEY=key
SONARR_URL=http://localhost:8989
