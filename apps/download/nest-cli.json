{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": {
      "type": "swc",
      "options": { "stripLeadingPaths": true }
    },
    "deleteOutDir": true,
    "assets": [{ "include": "db/migrations/**/*", "watchAssets": true }]
  }
}
