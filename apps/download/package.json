{
  "name": "@lilnas/download",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "packageManager": "pnpm@12.14.0",
  "prettier": "@lilnas/prettier",
  "files": [
    "./.next",
    "./dist"
  ],
  "scripts": {
    "build": "run-p build:*",
    "build:backend": "nest build -b swc --type-check",
    "build:frontend": "next build",
    "clean": "rm -rf .next/ dist/ .turbo/",
    "db:generate": "drizzle-kit generate",
    "deploy": "fly deploy",
    "dev": "concurrently -k --kill-others-on-fail \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "nest start -w -b swc | pino-pretty",
    "dev:frontend": "next dev -p 8080",
    "lint": "run-p -l 'lint:!(fix)'",
    "lint:eslint": "eslint src",
    "lint:prettier": "prettier -c src",
    "lint:fix": "run-p -l lint:*:fix",
    "lint:eslint:fix": "eslint --fix src",
    "lint:prettier:fix": "prettier -w src",
    "start": "run-p start:*",
    "start:backend": "node dist/main",
    "start:frontend": "node server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ytdlp-update": "docker build -f src/ytdlp-update/__tests__/Dockerfile.test -t ytdlp-update-test . && docker run --rm ytdlp-update-test",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@lilnas/media": "workspace:*",
    "@lilnas/utils": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/platform-ws": "11.1.6",
    "@nestjs/schedule": "6.0.1",
    "@nestjs/websockets": "11.1.6",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "axios": "1.12.2",
    "better-sqlite3": "^12.10.0",
    "content-disposition": "1.0.0",
    "dotenv": "17.2.3",
    "drizzle-orm": "^0.45.2",
    "fs-extra": "11.3.2",
    "mime-types": "^3.0.1",
    "minio": "8.0.6",
    "nanoid": "5.1.6",
    "nestjs-minio": "2.6.2",
    "nestjs-pino": "4.4.1",
    "nestjs-zod": "^5.0.1",
    "next": "15.5.20",
    "npm-run-all": "4.1.5",
    "pino-http": "11.0.0",
    "prom-client": "^15.1.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-icons": "^5.7.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "semver": "7.7.3",
    "source-map-support": "0.5.21",
    "ts-pattern": "5.8.0",
    "ws": "8.21.2",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@lilnas/cli": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/content-disposition": "0.5.9",
    "@types/jest": "30.0.0",
    "@types/ws": "8.18.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.9",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
