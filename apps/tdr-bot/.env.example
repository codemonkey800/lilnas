# Template for apps/tdr-bot/.env (dev) and apps/tdr-bot/.env.prod (prod).
# Both are gitignored; this example file is committed.
#
# The dev container (deploy.dev.yml) layers its environment, later wins:
#   1. .env.prod: production services and keys, shared by default
#   2. .env: the dev Discord bot, plus any overrides below
#   3. deploy.dev.yml: NODE_ENV=development and the dev database, pinned
# So .env only needs the "Dev bot" section. Anything else set there points
# the dev bot at a different service than production uses.
#
# .env.prod must hold the full set of keys below.

# ─── Dev bot (required in .env) ───────────────────────────────────────────────
# Must NOT match .env.prod: the dev container refuses to boot if these fall
# through to the production bot (scripts/dev-container.sh).
DISCORD_API_TOKEN=token
DISCORD_CLIENT_ID=id
# Guild that slash commands register in (guild-scoped, so updates show up
# immediately).
DISCORD_GUILD_ID=id

# Tokens used by scripts/*.ts, which read this file directly.
# The dev token needs Manage Channels in the dev guild.
#DISCORD_SCRIPTS_DEV_TOKEN=
#DISCORD_SCRIPTS_PROD_TOKEN=

# ─── Shared services (from .env.prod; override in .env to use a dev instance)
# Internal hostnames (storage, equations) resolve because the dev container
# joins the lilnas_default network.
EQUATIONS_API_KEY=key
EQUATIONS_URL=http://equations:8080

MINIO_ACCESS_KEY=key
MINIO_SECRET_KEY=key
MINIO_HOST=storage
MINIO_PORT=9000
MINIO_PUBLIC_URL=https://storage.lilnas.io

SONARR_URL=https://sonarr.lilnas.io
SONARR_API_KEY=key
RADARR_URL=https://radarr.lilnas.io
RADARR_API_KEY=key
EMBY_URL=https://emby.lilnas.io
EMBY_API_TOKEN=token
EMBY_USER_ID=id

HUGGING_FACE_TOKEN=key
OPENAI_API_KEY=key
SERP_API_KEY=key
TAVILY_API_KEY=key

# Download service API that /download creates jobs on. Default:
# http://download:8081 (production). Set to http://lilnas-download-dev:8081 to
# use the download dev container instead.
#DOWNLOAD_API_URL=
# Base URL for the job links /download posts. Default: https://download.lilnas.io
#DOWNLOAD_URL=

# Grafana alerting -> Discord (POST /alerts/grafana).
# Channel the bot posts Grafana alert notifications into.
#ALERTS_CHANNEL_ID=
# Bearer token Grafana's webhook contact point sends. Must match the value in
# lilnas infra/.env.monitoring. Generate with: openssl rand -hex 32
# When unset, the endpoint rejects every request (fail closed).
#GRAFANA_WEBHOOK_TOKEN=

# ─── App settings ─────────────────────────────────────────────────────────────
NODE_ENV=production
TZ=America/Los_Angeles
BACKEND_PORT=8081
FRONTEND_PORT=8080
# How long /download waits for a job to finish before giving up.
DOWNLOAD_JOB_TIMEOUT_MS=100000

# ─── Production database (.env.prod only; the dev database is pinned in
# deploy.dev.yml)
DATABASE_URL=postgresql://tdr_bot:changeme@tdr-bot-db:5432/tdr_bot
POSTGRES_DB=tdr_bot
POSTGRES_USER=tdr_bot
POSTGRES_PASSWORD=changeme
