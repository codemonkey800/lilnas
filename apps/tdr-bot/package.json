{
  "name": "@lilnas/tdr-bot",
  "license": "MIT",
  "private": true,
  "sideEffects": false,
  "packageManager": "pnpm@12.14.0",
  "prettier": "@lilnas/prettier",
  "files": [
    "./dist",
    "./drizzle"
  ],
  "scripts": {
    "build": "run-p build:*",
    "build:backend": "nest build -b swc --type-check",
    "build:frontend": "next build",
    "clean": "rm -rf .next/ dist/ .turbo/",
    "deploy": "fly deploy",
    "dev": "run-p dev:backend dev:frontend",
    "dev:backend": "nest start -w -b swc | pino-pretty",
    "dev:frontend": "next dev -p ${PORT:-8080}",
    "dev:graph-test": "GRAPH_TEST=true pnpm run dev",
    "lint": "run-p -l 'lint:!(fix)'",
    "lint:eslint": "eslint src",
    "lint:prettier": "prettier -c src",
    "lint:fix": "run-p -l lint:*:fix",
    "lint:eslint:fix": "eslint --fix src",
    "lint:prettier:fix": "prettier -w src",
    "start": "run-s start:migrate start:servers",
    "start:servers": "run-p start:backend start:frontend",
    "start:backend": "node dist/main",
    "start:frontend": "node frontend/apps/tdr-bot/server.js",
    "start:migrate": "node dist/db/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --watch",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --coverage",
    "test:live": "LIVE_LLM=1 NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --testMatch '**/*.live.test.ts' --runInBand",
    "type-check": "tsc7 --noEmit"
  },
  "dependencies": {
    "@langchain/core": "1.2.20",
    "@langchain/langgraph": "1.5.1",
    "@langchain/langgraph-checkpoint-postgres": "1.1.0",
    "@langchain/openai": "1.6.3",
    "@langchain/tavily": "1.2.0",
    "@libsql/client": "0.18.0",
    "@lilnas/media": "workspace:*",
    "@lilnas/utils": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/schedule": "12.0.2",
    "@prometheus-io/client": "^0.16.1",
    "@tavily/core": "0.7.14",
    "@willsoto/nestjs-prometheus": "^7.0.0",
    "async-mutex": "^0.5.0",
    "axios": "1.20.0",
    "cheerio": "1.2.0",
    "cron": "^4.4.0",
    "dayjs": "1.11.23",
    "dedent": "1.7.2",
    "discord.js": "14.27.0",
    "dotenv": "18.0.8",
    "drizzle-orm": "^0.45.4",
    "fs-extra": "11.4.1",
    "http-server": "14.1.1",
    "lodash": "4.18.1",
    "lru-cache": "11.5.3",
    "minio": "8.0.7",
    "nanoid": "6.0.2",
    "necord": "7.0.0",
    "nestjs-minio": "2.8.2",
    "nestjs-pino": "5.3.1",
    "node-docker-api": "1.1.22",
    "node-schedule": "2.1.1",
    "npm-run-all": "4.1.5",
    "pg": "^8.23.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "remark": "15.0.1",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "source-map-support": "0.5.21",
    "ts-pattern": "5.9.2",
    "unist-util-visit": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@lilnas/cli": "workspace:*",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@nestjs/testing": "12.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "5.104.5",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.6.1",
    "clsx": "2.1.1",
    "drizzle-kit": "^0.31.11",
    "jotai": "3.0.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "^4.3.3"
  }
}
