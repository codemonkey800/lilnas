# Intermediate output from `pnpm mockups`. The finished mockups
# (docs/features/*/designs/*.html) are committed — they're the thing you open
# in a browser from a fresh clone.
docs/features/*/designs/.build/

# Helm chart dependencies
k8s/charts/*/charts/*.tgz

# Agent/browser-automation scratch dirs (created and removed mid-run;
# watching them races the delete and breaks live file watching)
.playwright-mcp/

# raw responses from the download backend verification sweep
# (apps/download/scripts/verify) — these hold real requester emails and the
# real contents of the library, so they never leave the host they were
# captured on. Regenerate with `verify-backend.ts capture`.
apps/download/scripts/verify/captures/

# real Emby posters + YouTube thumbnails for the download-app mockup —
# studio/uploader-owned art, regenerated locally instead of committed to
# this public repo; see docs/features/download/designs/assets/README.md
docs/features/download/designs/assets/emby/
docs/features/download/designs/assets/video/
