.cache/
# Env files. The production set is committed encrypted with dotenvx (see
# `lilnas secrets --help`); dev env files, the key file, and the `.decrypted`
# siblings the deploy writes next to each encrypted file never are.
.env
.env.*
!.env.*.example
!.env.example
!.env.fish
# the committed, encrypted set — must match listEncryptedEnvFiles() in
# packages/cli/src/utils/secrets.ts
!apps/*/.env.prod
!infra/.env
!infra/.env.*
# re-ignored after the negations above, wherever they sit
.env.keys
**/.env.keys
*.decrypted
# `git check-ignore -v` proof — NOT ignored: apps/tdr-bot/.env.prod,
# infra/.env, infra/.env.storage, infra/.env.storage.example; ignored:
# .env.keys, apps/tdr-bot/.env.prod.decrypted, infra/.env.storage.decrypted,
# apps/tdr-bot/.env, apps/download/.env.dev-remote, apps/tdr-code/.env,
# .env.turbo
.next/
.pnpm-store/
.turbo/*
!.turbo/config.json
*.tsbuildinfo
*.log
coverage/
data/
!docs/features/*/designs/src/data/
dist/
apps/tdr-code/server.js
infra/dev.yml
apps/tdr-bot/logs/
apps/theater/public/models/*.fbx
apps/theater/public/animations/*.fbx
node_modules/
REVIEW.md
*.db
*.db-shm
*.db-wal
truereflection-dev/
player.html

# Intermediate output from `pnpm mockups`. The finished mockups
# (docs/features/*/designs/*.html) are committed — they're the thing you open
# in a browser from a fresh clone.
docs/features/*/designs/.build/

# Helm chart dependencies
k8s/charts/*/charts/*.tgz

# Agent/browser-automation scratch dirs (created and removed mid-run;
# watching them races the delete and breaks live file watching)
.playwright-mcp/
.playwright-cli/

# raw responses from the download backend verification sweep
# (apps/download/scripts/verify) — these hold real requester emails and the
# real contents of the library, so they never leave the host they were
# captured on. Regenerate with `verify-backend.ts capture`.
apps/download/scripts/verify/captures/

# real Emby posters + YouTube thumbnails for the download-app mockup —
# studio/uploader-owned art, regenerated locally instead of committed to
# this public repo; see docs/features/download/designs/assets/README.md
docs/features/download/designs/assets/emby/
docs/features/download/designs/assets/video/
