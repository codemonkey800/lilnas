extends ../../../../../designs/mockup-kit/page.pug

include ../mixins/start.pug

block title
  | icloud-backup — start · UI mockups

//-
  The sign-in flow: pre-flight, Apple ID and password, a turn, the code, and
  the hand-over. Copy and sample data are in src/data/start.mjs.

block content
  +mockHead({ eyebrow: 'icloud-backup · /', title: 'Start', back: true })
    p The page a person sees until they are signed in. One thing to do per screen, so each step is its own screen: check two settings, give Apple the Apple ID and password, wait for a turn if someone else is signing in, then type the code from an Apple device. #[+code('Continue')] and #[+code('Sign in')] are the one accent button on their screens. Every state is shown at 1280 and 390.

  - const d = { appleId, preflight, signIn, waiting, code, handover }
  - const groups = []
  - screens.forEach(s => { let g = groups.find(x => x.name === s.group); if (!g) { g = { name: s.group, items: [] }; groups.push(g) } g.items.push(s) })
  div(class='vp-scope flex flex-col items-center gap-8')
    +viewportToggle('start-viewport')
    +viewportPanel('desktop')
      each s in screens
        +stateRow(s.label + ' · ' + s.caption, { stack: true })(class='w-full' id=s.key)
          +startScreen('desktop', s, d)
      +frameLabel Desktop · 1280
    +viewportPanel('mobile')
      each g in groups
        +stateRow(g.name, { stack: true })(class='w-full')
          each s in g.items
            +stateCell(s.label)(class='w-[390px]')
              +startScreen('mobile', s, d)
      +frameLabel Mobile · 390
