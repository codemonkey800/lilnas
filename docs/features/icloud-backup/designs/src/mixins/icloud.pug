//-
  icloud-backup-only pieces. The kit supplies the components; these are the
  frame every screen sits in and the few blocks that only this app has.

//- The app bar. Family screens show the signed-in email and an avatar; the
//- admin page uses the kit's bar so it can carry the two nav links.
mixin ibBar(view, opts)
  - opts = opts || {}
  - const mobile = view === 'mobile'
  if opts.admin
    +appBar(view, { app: 'icloud-backup', initials: opts.initials || 'JA', links: opts.links })
  else
    header(class='flex h-14 w-full shrink-0 items-center gap-4 border-b border-line bg-surface px-4')
      +doorplate('icloud-backup')
      span(class='flex-1')
      unless mobile
        span(class='text-sm text-ink-3')= opts.email || 'sam@example.com'
      +avatar(opts.initials || 'SM', { size: 32, you: true })

//- The column a screen sits in: narrow for family screens, wide for admin.
mixin ibMain(view, opts)
  - opts = opts || {}
  - const mobile = view === 'mobile'
  main(
    class=[
      'w-full flex-1',
      mobile ? 'px-4 py-6' : 'mx-auto px-8 py-12',
      mobile ? '' : opts.wide ? 'max-w-[1040px]' : 'max-w-[560px]',
    ]
  )&attributes(attributes)
    block

//-
  One screen: the frame, the bar, an optional banner strip under the bar, then
  the column. `opts.banner` is { lead, detail }.
mixin ibScreen(view, opts)
  - opts = opts || {}
  +appFrame(view, { height: opts.height, density: opts.density })&attributes(attributes)
    +ibBar(view, opts)
    if opts.banner
      div(class='flex items-center gap-2.5 border-b border-line bg-warn-ghost px-4 py-2.5 text-sm text-ink-2' role='status')
        span(class='size-3.5 shrink-0 animate-spin rounded-full border-2 border-warn border-t-transparent' aria-hidden='true')
        p
          strong(class='font-semibold text-warn')= opts.banner.lead + ' '
          = opts.banner.detail
    +ibMain(view, opts)
      block

//- The three-step marker on the sign-in screens.
mixin steps(n, total, label)
  div(class='mb-4 flex items-center gap-3')
    span(class='flex gap-1' aria-hidden='true')
      - for (let i = 1; i <= total; i++)
        span(class=['h-1 w-6 rounded-full', i <= n ? 'bg-accent' : 'bg-surface-3'])
    span(class='text-cap text-ink-3') Step #{n} of #{total} · #{label}

//- Title and the one line under it.
mixin intro(title, lede)
  h1(class='text-h1')= title
  if lede
    p(class='mt-2 text-body text-ink-2')= lede

//- A badge, then the title and lede.
mixin stateHead(b, title, lede)
  div(class='mb-4')
    +badge(b)
  +intro(title, lede)

//- One row of the pre-flight checklist.
mixin checkItem(item)
  li(class='flex gap-3 rounded-lg border border-line bg-surface p-4')
    span(class='grid size-[30px] shrink-0 place-items-center rounded-md bg-accent-ghost text-accent-hi')
      +icon(item.icon, 16)
    div(class='min-w-0')
      h3(class='text-h3')= item.title
      p(class='mt-1 text-sm text-ink-3')= item.where

//-
  Six digit cells. `filled` shows bullets, never a real code; the first cell
  takes the forced focus ring when the screen is empty.
mixin codeBoxes(opts)
  - opts = opts || {}
  div(class='flex gap-2' role='group' aria-label='6-digit code')&attributes(attributes)
    - for (let i = 0; i < 6; i++)
      input(
        data-control
        type='text'
        inputmode='numeric'
        maxlength='1'
        autocomplete='one-time-code'
        value=opts.filled ? '•' : undefined
        disabled=opts.disabled
        aria-label=`Digit ${i + 1}`
        aria-invalid=opts.error ? 'true' : undefined
        data-force=!opts.filled && i === 0 ? 'focus' : undefined
        class=[
          'h-12 w-12 min-w-0 rounded-md border bg-bg-sunk text-center font-mono text-h2',
          'transition-[border-color,box-shadow] duration-200 ease-standard',
          'focus:border-accent focus:ring-2 focus:ring-accent-ghost focus:outline-none disabled:opacity-40',
          opts.error ? 'border-bad' : 'border-line-control',
        ]
      )

//- The Immich sign-in block on the done screens. mode: new | revealed | existing
mixin immichPanel(view, mode, c)
  - const mobile = view === 'mobile'
  +panel(c.title)
    div(class='flex flex-col gap-0.5')
      span(class='text-label text-ink-3 uppercase') Email
      span(class='font-mono text-mono')= c.email
    if mode === 'new'
      p(class='mt-3 text-sm text-ink-3')= c.newHint
      +btn({ label: c.create, icon: 'key', touch: mobile })(class=['mt-3', mobile ? 'w-full' : ''])
    else if mode === 'revealed'
      p(class='mt-3 text-sm text-ink-3')= c.revealedHint
      +card({ sunk: true })(class='mt-2 flex items-center justify-between gap-3 px-3 py-2.5')
        code(class='min-w-0 truncate font-mono text-mono text-ink')= c.password
        +btn({ size: 'sm', label: c.copy })
      p(class='mt-2 text-cap text-warn')= c.revealedWarn
    else
      p(class='mt-3 text-sm text-ink-3')= c.existingHint
