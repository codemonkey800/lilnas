//- The sign-in flow, one mixin per screen. Copy lives in data/start.mjs.
include icloud.pug

mixin preflightScreen(view, c)
  - const mobile = view === 'mobile'
  +ibScreen(view)
    +steps(1, 3, c.step)
    +intro(c.title, c.lede)
    ul(class='stagger mt-6 flex flex-col gap-3')
      each item in c.items
        +checkItem(item)
    +btn({ variant: 'accent', label: c.action, iconEnd: 'arrow', size: mobile ? 'lg' : 'md' })(class=['mt-6', mobile ? 'w-full' : ''])

mixin signInScreen(view, state, c, appleId)
  - const mobile = view === 'mobile'
  - const locked = state === 'submitting'
  +ibScreen(view)
    +steps(2, 3, c.step)
    +intro(c.title, c.lede)
    +note('accent', c.privacy.lead)(class='mt-5')
      = c.privacy.detail
    if state === 'space'
      +note('warn', c.lowSpace.lead)(class='mt-3')
        = c.lowSpace.detail
    div(class='mt-5 flex flex-col gap-4')
      +field(c.idLabel, c.idHint)
        +input({ type: 'email', placeholder: appleId, value: state === 'empty' || state === 'space' ? undefined : appleId, disabled: locked })(data-force=state === 'empty' ? 'focus' : undefined)
      +field(c.passwordLabel, null, state === 'wrong' ? c.wrongPassword : null)
        +input({ type: 'password', value: state === 'empty' || state === 'space' ? undefined : 'placeholder', error: state === 'wrong', disabled: locked })
    +btn({
      variant: 'accent',
      label: locked ? c.submitting : c.action,
      loading: locked,
      disabled: state === 'space',
      size: mobile ? 'lg' : 'md',
    })(class=['mt-6', mobile ? 'w-full' : ''])

mixin waitingScreen(view, c)
  +ibScreen(view)
    +steps(2, 3, c.step)
    +stateHead(c.badge, c.title, c.lede)
    +card({ sunk: true })(class='mt-6 flex items-center gap-3')
      +statusDot('accent', true)
      p(class='text-sm text-ink-3')= c.hint

mixin codeScreen(view, state, c)
  - const mobile = view === 'mobile'
  +ibScreen(view)
    +steps(3, 3, c.step)
    +intro(c.title, c.lede)
    p(class='mt-1 text-sm text-ink-3')= c.hint
    div(class='mt-6')
      +codeBoxes({ filled: state !== 'empty', disabled: state === 'checking', error: state === 'wrong' })
      if state === 'wrong'
        p(class='mt-2 text-xs text-bad')= c.wrong
    +btn({
      variant: 'accent',
      label: state === 'checking' ? c.checking : c.action,
      loading: state === 'checking',
      size: mobile ? 'lg' : 'md',
    })(class=['mt-6', mobile ? 'w-full' : ''])

mixin handoverScreen(view, c)
  +ibScreen(view)
    div(class='flex flex-col items-center py-8 text-center')
      span(class='mb-4 grid size-12 place-items-center rounded-full bg-ok-ghost text-ok')
        +icon('check', 24)
      h1(class='text-h1')= c.title
      p(class='mt-2 text-body text-ink-2')= c.lede
      +progress(null, 'accent', { bare: true })(class='mt-6 w-48')

//- Dispatch on a screen's `kind`.
mixin startScreen(view, s, d)
  if s.kind === 'preflight'
    +preflightScreen(view, d.preflight)
  else if s.kind === 'signin'
    +signInScreen(view, s.state, d.signIn, d.appleId)
  else if s.kind === 'waiting'
    +waitingScreen(view, d.waiting)
  else if s.kind === 'code'
    +codeScreen(view, s.state, d.code)
  else
    +handoverScreen(view, d.handover)
