extends ../../../../../designs/mockup-kit/page.pug

include ../mixins/download.pug

block title
  | download — home · UI mockups

//-
  The homepage: the giant search hero, quick access and what was added lately.
  The loading and error states are drawn as their own rows. Copy and sample
  data are in src/data/home.mjs.

//- Quick access: four tiles — a 4-up row on desktop, a stack on a phone.
mixin quickAccess(view)
  h2(class='mb-3 text-h2') Quick access
  div(class=['grid gap-3', view === 'mobile' ? 'grid-cols-1' : 'grid-cols-4'])
    each item in QUICK
      +tile(item)

//- Recently added: a wrapping grid of gallery cards, two-up on a phone.
mixin recentlyAdded(view)
  - const phone = view === 'mobile'
  div(class='mt-10 mb-3 flex items-center justify-between')
    h2(class='text-h2') Recently added
    +btn({ variant: 'ghost', size: 'sm', label: 'See full library', iconEnd: 'arrow' })
  div(class=['grid gap-4 stagger', phone ? 'grid-cols-2' : 'grid-cols-[repeat(auto-fill,minmax(158px,1fr))]'])
    each entry in (phone ? RECENT.slice(0, 4) : RECENT)
      +galleryCard(entry)

//- The loading state is the page's geometry, not a spinner on an empty screen.
mixin homeSkeleton(view)
  - const phone = view === 'mobile'
  div(aria-busy='true')
    div(class=['flex flex-col items-center gap-4', phone ? 'pt-4 pb-8' : 'pt-10 pb-14'])
      +skeleton()(class=phone ? 'h-10 w-4/5' : 'h-14 w-[480px]')
      +skeleton()(class='h-11 w-full max-w-[680px] rounded-md')
    p(class='mb-3 text-h2') Quick access
    div(class=['grid gap-3', phone ? 'grid-cols-1' : 'grid-cols-4'])
      each n in [1, 2, 3, 4]
        div(class='flex items-center gap-3 rounded-lg border border-line bg-surface p-3')
          +skeleton()(class='size-[30px] shrink-0 rounded-md')
          div(class='flex flex-1 flex-col gap-2')
            +skeleton()(class='h-3.5 w-24')
            +skeleton()(class='h-3 w-16')
    p(class='mt-10 mb-3 text-h2') Recently added
    div(class=['grid gap-4', phone ? 'grid-cols-2' : 'grid-cols-[repeat(auto-fill,minmax(158px,1fr))]'])
      each n in (phone ? [1, 2, 3, 4] : [1, 2, 3, 4, 5, 6])
        div(class='flex flex-col gap-2 rounded-lg border border-line bg-surface p-2.5')
          +skeleton('poster')(class='aspect-[2/3] h-auto w-full rounded-md')
          +skeleton()(class='h-3.5')
          +skeleton()(class='h-3 w-2/3')

block content
  +mockHead({ back: true, eyebrow: 'download · home', title: 'Home' })
    p One field does both jobs: paste a link and it goes to yt-dlp, type a title and it goes to search. Below it, quick access to the three libraries and activity, then what was added lately.

  +mockSection('home', 'Home', 'The hero keeps the giant single input — Geist 600 at 60px on desktop, 36px on a phone — over one 44px field.')
    +viewports('home-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +screenRow('Default')
            +appFrame(view)
              +dlBar(view, { active: 'library', search: false })
              +dlMain(view)
                +hero(view, { title: 'What are we downloading?', hint: 'Movies and shows go to Radarr and Sonarr. Any other link goes to yt-dlp.' })
                +quickAccess(view)
                +recentlyAdded(view)
          +screenRow('Loading · the page’s own geometry')
            +appFrame(view)
              +dlBar(view, { active: 'library', search: false })
              +dlMain(view)
                +homeSkeleton(view)
          +screenRow('Error · the download service didn’t answer')
            +appFrame(view)
              +dlBar(view, { active: 'library', search: false })
              +dlMain(view)
                +boundaryError(view)
