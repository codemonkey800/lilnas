extends ../../../../../designs/mockup-kit/page.pug

include ../mixins/download.pug

block title
  | download — show detail · UI mockups

//-
  /shows/[tvdbId]: the movie page's state machine at three levels — the
  series, a season and an episode. Season tabs sit under the header, each
  episode is a row, and the Manage button opens an inline drawer under its
  row. Copy and sample data are in src/data/show-detail.mjs.

mixin showHeader(view, state, note)
  +detailHead(view, SHOW)&attributes(attributes)
    +lifecycle(note)
      +mediaBadge(state)
    block

mixin requestRow(view, opts)
  - opts = opts || {}
  - const phone = view === 'mobile'
  div(class='flex flex-col gap-2')
    +actionRow(view)(class=phone ? '' : 'items-end')
      +tierSelect({ tiers: QUALITY_TIERS, selected: 'hd', open: opts.open, full: phone })
      +btn({ variant: 'accent', label: 'Download series', icon: 'download' })
    p(class='max-w-[56ch] text-cap text-ink-3')= TIER_HINT

mixin libraryActions(view)
  +actionRow(view)
    +btn({ variant: 'outline', label: 'Download series', iconEnd: 'download' })
    +btn({ variant: 'bad', label: 'Delete series', iconEnd: 'trash' })

//- Season tabs: scroll sideways on a phone.
mixin seasonTabs(view)
  +tabs()(class=['mb-4', view === 'mobile' ? 'overflow-x-auto' : ''] aria-label='Season')
    each s in SEASONS
      +tab(s.label, s.selected, s.count)

//- What the drawer under an episode offers, by state.
mixin episodeActions(view, state)
  +actionRow(view)
    case state
      when 'available'
        +btn({ variant: 'accent', size: 'sm', label: 'Watch', iconEnd: 'eye' })
        +btn({ variant: 'outline', size: 'sm', label: 'Save to device', iconEnd: 'device' })
        +btn({ variant: 'ghost', size: 'sm', label: 'Report a problem', iconEnd: 'flag' })
        +btn({ variant: 'bad', size: 'sm', label: 'Delete episode', iconEnd: 'trash' })
      when 'downloading'
        +btn({ variant: 'bad', size: 'sm', label: 'Cancel', iconEnd: 'x' })
      when 'needs_attention'
        +btn({ variant: 'accent', size: 'sm', label: 'Import', iconEnd: 'check' })
        +btn({ variant: 'bad', size: 'sm', label: 'Discard', iconEnd: 'trash' })
      default
        +btn({ variant: 'outline', size: 'sm', label: 'Download', iconEnd: 'download' })

//- A season: heading and its two actions, then its episodes. `open` is the index of the row whose drawer is drawn.
mixin season(view, opts)
  - opts = opts || {}
  - const phone = view === 'mobile'
  div(class=['mb-3 flex gap-3', phone ? 'flex-col' : 'items-center justify-between'])
    h2(class='text-h2') Season 2 · 7 episodes
    +actionRow(view)
      +btn({ variant: 'outline', size: 'sm', label: 'Download season', iconEnd: 'download' })
      +btn({ variant: 'bad', size: 'sm', label: 'Delete season', iconEnd: 'trash' })
  +card()(class='px-3 py-0')
    each ep, i in EPISODES
      +episodeRow(ep, view, { open: opts.open === i })
        +episodeActions(view, ep.state)

mixin stateFrame(view, key, opts)
  - opts = opts || {}
  - const s = STATES[key]
  +appFrame(view)
    +dlMain(view)
      +showHeader(view, key, opts.note)
        if key === 'absent' || key === 'wanted'
          +requestRow(view)
      if s
        +attempts(view, s.attempts)

mixin showSkeleton(view)
  - const phone = view === 'mobile'
  div(aria-busy='true')
    div(class=['flex gap-6', phone ? 'flex-col' : 'items-start'])
      +skeleton('poster')(class=['aspect-[2/3] h-auto', phone ? 'w-[132px]' : 'w-[200px]'])
      div(class='flex flex-1 flex-col gap-4')
        +skeleton()(class='h-6 w-2/5')
        +skeleton()(class='h-3.5 w-3/5')
        +skeleton('lines')(class='max-w-[64ch]')
        +skeleton()(class='mt-2 h-6 w-28 rounded-full')
        +skeleton()(class='h-9 w-40 rounded-md')
    div(class='mt-8 mb-4 flex gap-6 border-b border-line pb-3')
      each w in [64, 64, 64, 64]
        +skeleton()(class='h-4' style=`width: ${w}px`)
    div(class='flex flex-col gap-2')
      each n in [1, 2, 3, 4]
        div(class='flex items-center gap-4 rounded-lg border border-line bg-surface p-3')
          +skeleton()(class='h-3.5 w-8')
          +skeleton()(class='h-3.5 w-2/5')
          +skeleton()(class='ml-auto h-6 w-24 rounded-full')

block content
  +mockHead({ back: true, eyebrow: 'download · /shows/[tvdbId]', title: 'Show detail' })
    p The movie page’s state machine at three levels: the whole series, one season, one episode. The badge reads the same seven states at every level; Download and Delete exist at every level too, and use the one quality tier the series has.
    +jumpNav([['Default', 'default'], ['Media states', 'states'], ['Seasons and episodes', 'episodes'], ['Dialogs', 'dialogs'], ['Boundaries', 'boundaries']])(class='mt-4')

  +mockSection('default', 'In the library', 'Header, facts and cast, the series-level attempts, then the season tabs and the open season’s episodes.')
    +viewports('show-default-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +screenRow('Default · in library, episode drawer open')
            +appFrame(view)
              +dlBar(view, { active: 'library' })
              +dlMain(view)
                +showHeader(view, 'available')
                  +libraryActions(view)
                  p(class='flex items-center gap-2 text-cap text-ink-3')
                    +avatar(ADDED.who[0], { size: 24 })
                    | Added by #{ADDED.who[1]} · #{ADDED.when}
                +facts(view, 'Details', FACTS)
                +castRow(CAST, CAST_MORE)
                +attempts(view, ATTEMPTS_DEFAULT)
                div(class='mt-8')
                  +seasonTabs(view)
                  +season(view, { open: OPEN_EPISODE })

  +mockSection('states', 'The seven media states', 'The same badge and actions as a movie. A show’s attempts name the part they were for — “Season 3, episode 7”.')
    +viewports('show-states-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +screenRow('State · not downloaded')
            +stateFrame(view, 'absent', { note: 'Nothing is on disk and nothing has been asked for.' })
          +screenRow('State · wanted')
            +stateFrame(view, 'wanted', { note: 'Sonarr is watching for releases. Episodes download as they appear.' })
          +screenRow('State · downloading')
            +stateFrame(view, 'downloading')
          +screenRow('State · importing')
            +stateFrame(view, 'importing')
          +screenRow('State · needs attention')
            +stateFrame(view, 'needs_attention', { note: 'Sonarr stopped on one episode and is waiting for you.' })
          +screenRow('State · paused')
            +stateFrame(view, 'paused')
          +screenRow('State · in library')
            +appFrame(view)
              +dlMain(view)
                +showHeader(view, 'available')
                  +libraryActions(view)
          +screenRow('One episode cancelled inside a running season pack')
            +appFrame(view)
              +dlMain(view)
                +showHeader(view, 'downloading')
                +attempts(view, PACK_CANCEL)
          +screenRow('Sonarr upgrade · a file already on disk, not ours to cancel')
            +appFrame(view)
              +dlMain(view)
                +showHeader(view, 'available')
                  +libraryActions(view)
                +progressBlock(view, EXTERNAL)(class='mt-8')

  +mockSection('episodes', 'Seasons and episodes', 'Each episode row carries its own state, a bar while it downloads, and one Manage button that opens the drawer under it.')
    +viewports('show-episodes-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +screenRow('Season 2 · all drawers closed')
            +appFrame(view)
              +dlMain(view)
                +seasonTabs(view)
                +season(view)
          +screenRow('Drawer · an episode that’s downloading')
            +appFrame(view)
              +dlMain(view)
                +seasonTabs(view)
                +season(view, { open: 2 })
          +screenRow('Drawer · an episode that needs attention')
            +appFrame(view)
              +dlMain(view)
                +seasonTabs(view)
                +season(view, { open: 1 })
          +screenRow('Drawer · an episode that isn’t downloaded')
            +appFrame(view)
              +dlMain(view)
                +seasonTabs(view)
                +season(view, { open: 5 })

  +mockSection('dialogs', 'Delete confirms', 'The copy changes with how far the delete reaches. A shared file names the other episode; the last episode of a season or a series says what else goes.')
    +viewports('show-dialogs-viewport')
      each view in ['desktop', 'mobile']
        - const phone = view === 'mobile'
        +viewportPanel(view)
          each key in ['shared', 'lastOfSeason', 'lastOfSeries', 'season', 'series']
            - const d = DELETE[key]
            - const labels = { shared: 'Episode · its file also holds the next one', lastOfSeason: 'Episode · the last of its season', lastOfSeries: 'Episode · the last of the series (cascade)', season: 'Season', series: 'Series' }
            +screenRow(`Delete · ${labels[key]}`)
              +appFrame(view, { height: phone ? 520 : 400 })
                +dlBar(view, { active: 'library' })
                +dlMain(view)
                  +showHeader(view, 'available')
                    +libraryActions(view)
                +dialog({ title: d.title, confirm: 'Delete', cancel: 'Keep it', destructive: true })
                  = d.body
          +screenRow('Report a problem · episode')
            +appFrame(view, { height: phone ? 640 : 520 })
              +dlBar(view, { active: 'library' })
              +dlMain(view)
                +seasonTabs(view)
                +season(view, { open: 0 })
              +dialog({ title: 'What’s wrong with this episode?', confirm: 'Report problem', cancel: 'Cancel' })
                fieldset(class='flex flex-col gap-2.5')
                  legend(class='sr-only') What’s wrong with this episode?
                  each reason, i in REASONS
                    +radio({ name: `show-report-${view}`, label: reason, checked: i === 0 })
                p(class='mt-3 text-cap text-ink-3') This app won’t pick this release again. Radarr and Sonarr can still grab it from their own interfaces.

  +mockSection('boundaries', 'Loading, not found, error', 'The route’s own loading skeleton, a show Sonarr has never heard of, and the error boundary.')
    +viewports('show-boundaries-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +screenRow('Loading · the page’s own geometry')
            +appFrame(view)
              +dlBar(view, { active: 'library' })
              +dlMain(view)
                +showSkeleton(view)
          +screenRow('Not in the library yet · no seasons to list')
            +appFrame(view)
              +dlMain(view)
                +showHeader(view, 'absent')
                  +requestRow(view)
                div(class='mt-8')
                  +note('accent', 'No seasons yet.')
                    | Downloading the series adds it to Sonarr, and the episode list appears here.
          +screenRow('Not found')
            +appFrame(view)
              +dlBar(view, { active: 'library' })
              +dlMain(view, { narrow: true })
                +boundaryNotFound(view, { title: 'No such show', body: 'Sonarr has no show at this address. Nothing has gone wrong — the link was probably mistyped, or the show was removed.', action: 'Back to library' })
          +screenRow('Error · show error boundary')
            +appFrame(view)
              +dlBar(view, { active: 'library' })
              +dlMain(view, { narrow: true })
                +boundaryError(view, { title: 'This show couldn’t be loaded', lead: 'The download service didn’t answer.', detail: 'None of this show’s seasons or downloads could be read. Nothing has been changed — trying again is safe.', digest: 'digest 1180042931' })
