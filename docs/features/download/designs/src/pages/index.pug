extends ../../../../../designs/mockup-kit/page.pug

include ../mixins/download.pug

block title
  | download — UI mockups

//-
  The index: one tile per route the app has today, then the two root boundaries
  (error.tsx and not-found.tsx), which belong to no single route. Copy and the
  route list are in src/data/index.mjs.

block content
  +mockHead({ eyebrow: 'lilnas · download', title: 'download — UI mockups' })
    p The download app on Category Standard: nine routes and the two boundaries every route falls back to. Each screen is drawn at 1280 and 390 behind a switch, and every state is a captioned row. Drawn with the shared kit in #[+code('docs/designs/mockup-kit')]; the rules are in #[+code('DESIGN.md')].

  +mockSection('routes', 'Routes', 'Nine screens, one per route in apps/download/src/app.')
    div(class='grid gap-x-4 gap-y-5 sm:grid-cols-2 lg:grid-cols-3 stagger')
      each screen in SCREENS
        div(class='flex flex-col gap-2')
          +tile({ icon: screen.icon, name: screen.title, host: screen.route, href: screen.href })
          p(class='px-1 text-cap text-ink-3')= screen.desc

  +mockSection('boundaries', 'Boundaries', 'What any route falls back to. The root error and not-found pages render inside the same app bar.')
    +viewports('boundaries-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +screenRow('Root error · error.tsx')
            +appFrame(view)
              +dlBar(view, { active: 'library' })
              +dlMain(view, { narrow: true })
                +boundaryError(view)
          +screenRow('Not found · not-found.tsx')
            +appFrame(view)
              +dlBar(view, { active: 'library' })
              +dlMain(view, { narrow: true })
                +boundaryNotFound(view)
