extends ../../../../../designs/mockup-kit/page.pug

include ../mixins/download.pug

block title
  | download — movie detail · UI mockups

//-
  /movies/[tmdbId]: one movie and everything you can do about it. The page
  is a state machine over the seven media states (media-state.ts) and the
  job's sixteen statuses (job-state.ts); each media state is a row below, then
  the request flow, the release picker, the dialogs and the two boundaries.
  Copy and sample data are in src/data/movie-detail.mjs.

//- The header, with the lifecycle badge for `state` and whatever the block adds.
mixin movieHeader(view, state, note)
  +detailHead(view, MOVIE)&attributes(attributes)
    +lifecycle(note)
      +mediaBadge(state)
    block

//- Quality tier and Download, side by side on desktop, stacked on a phone.
mixin requestRow(view, opts)
  - opts = opts || {}
  - const phone = view === 'mobile'
  div(class='flex flex-col gap-2')
    +actionRow(view)(class=phone ? '' : 'items-end')
      +tierSelect({ tiers: QUALITY_TIERS, selected: opts.selected || 'hd', open: opts.open, full: phone })
      +btn({ variant: 'accent', label: 'Download', icon: 'download' })
    p(class='max-w-[56ch] text-cap text-ink-3')= TIER_HINT

//- The actions on a movie that is in the library.
mixin libraryActions(view)
  +actionRow(view)
    +btn({ variant: 'accent', label: 'Watch', iconEnd: 'eye' })
    +btn({ variant: 'outline', label: 'Save to device', iconEnd: 'device' })
    +btn({ variant: 'bad', label: 'Delete', iconEnd: 'trash' })

//- Every fact the header doesn't already say, then the cast.
mixin movieFacts(view)
  +facts(view, 'Details', FACTS)
  +castRow(CAST, CAST_MORE)

//- One media state as a bare frame: the header, then the attempts it explains.
mixin stateFrame(view, key, opts)
  - opts = opts || {}
  - const s = STATES[key]
  +appFrame(view)
    +dlMain(view)
      +movieHeader(view, key, opts.note)
        if key === 'absent' || key === 'wanted'
          +requestRow(view)
      if s
        +attempts(view, s.attempts)
      if key === 'wanted'
        +releasePicker(view, { state: 'none' })

//- The skeleton is the page's own geometry: poster, title, meta, synopsis, an action, facts.
mixin movieSkeleton(view)
  - const phone = view === 'mobile'
  div(aria-busy='true')
    div(class=['flex gap-6', phone ? 'flex-col' : 'items-start'])
      +skeleton('poster')(class=['aspect-[2/3] h-auto', phone ? 'w-[132px]' : 'w-[200px]'])
      div(class='flex flex-1 flex-col gap-4')
        +skeleton()(class='h-6 w-2/5')
        +skeleton()(class='h-3.5 w-3/5')
        +skeleton('lines')(class='max-w-[64ch]')
        +skeleton()(class='mt-2 h-6 w-28 rounded-full')
        +skeleton()(class='h-9 w-40 rounded-md')
    div(class=['mt-8 grid gap-x-6 gap-y-4', phone ? 'grid-cols-2' : 'grid-cols-4'])
      each n in [1, 2, 3, 4, 5, 6, 7, 8]
        div(class='flex flex-col gap-2')
          +skeleton()(class='h-3 w-16')
          +skeleton()(class='h-3.5 w-24')

block content
  +mockHead({ back: true, eyebrow: 'download · /movies/[tmdbId]', title: 'Movie detail' })
    p The movie page, drawn once per media state. The badge under the title says where the movie is; the actions beside it are the ones that make sense there, and the Attempts list underneath is the history of getting it.
    +jumpNav([['Default', 'default'], ['Media states', 'states'], ['Request', 'request'], ['Releases', 'releases'], ['Dialogs', 'dialogs'], ['Boundaries', 'boundaries']])(class='mt-4')

  +mockSection('default', 'In the library', 'The page at rest: watch it, keep a copy, or delete it. Below the header, the facts, the cast and what happened to get it here.')
    +viewports('movie-default-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +screenRow('Default · in library')
            +appFrame(view)
              +dlBar(view, { active: 'library' })
              +dlMain(view)
                +movieHeader(view, 'available')
                  +libraryActions(view)
                  p(class='flex items-center gap-2 text-cap text-ink-3')
                    +avatar(ADDED.who[0], { size: 24, you: true })
                    | Added by #{ADDED.who[1]} · #{ADDED.when}
                +movieFacts(view)
                +attempts(view, ATTEMPTS_DEFAULT)
                +releasePicker(view, { state: 'results', releases: RELEASES })

  +mockSection('states', 'The seven media states', 'Not downloaded, wanted, downloading, importing, needs attention, paused, in library. The badge colour follows the tone map: accent in progress, ok available, warn queued or stuck.')
    +viewports('movie-states-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +screenRow('State · not downloaded')
            +stateFrame(view, 'absent', { note: 'Nothing is on disk and nothing has been asked for.' })
          +screenRow('State · wanted')
            +stateFrame(view, 'wanted', { note: 'Radarr is watching for a release. It’ll download when one appears.' })
          +screenRow('State · downloading')
            +stateFrame(view, 'downloading')
          +screenRow('State · importing')
            +stateFrame(view, 'importing')
          +screenRow('State · needs attention')
            +stateFrame(view, 'needs_attention', { note: 'Radarr stopped and is waiting for you.' })
          +screenRow('State · paused')
            +stateFrame(view, 'paused')
          +screenRow('State · in library')
            +appFrame(view)
              +dlMain(view)
                +movieHeader(view, 'available')
                  +libraryActions(view)
          +screenRow('Started from Radarr · adopted, attributed to Radarr')
            +appFrame(view)
              +dlMain(view)
                +movieHeader(view, 'downloading')
                +attempts(view, ADOPTED)
          +screenRow('Radarr upgrade · a file already on disk, not ours to cancel')
            +appFrame(view)
              +dlMain(view)
                +movieHeader(view, 'available')
                  +libraryActions(view)
                +progressBlock(view, EXTERNAL)(class='mt-8')

  +mockSection('request', 'Request', 'A quality tier and one Download. The tier is a cap: Up to 4K falls back to 1080p when no 4K release exists.')
    +viewports('movie-request-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +screenRow('Quality tier · closed')
            +appFrame(view)
              +dlMain(view)
                +requestRow(view)
          +screenRow('Quality tier · open')
            +appFrame(view)
              +dlMain(view)
                +requestRow(view, { open: true, selected: 'hd' })

  +mockSection('releases', 'Release picker', 'Ask every indexer, then choose. Flagged and rejected releases stay in the list with the reason beside them.')
    +viewports('movie-releases-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +screenRow('Not searched yet')
            +appFrame(view)
              +dlMain(view)
                +releasePicker(view, { state: 'idle' })
          +screenRow('Searching')
            +appFrame(view)
              +dlMain(view)
                +releasePicker(view, { state: 'searching' })
          +screenRow('Results · nothing on disk yet')
            +appFrame(view)
              +dlMain(view)
                +releasePicker(view, { state: 'results', releases: RELEASES_ABSENT })
          +screenRow('Results · replacing the current file')
            +appFrame(view)
              +dlMain(view)
                +releasePicker(view, { state: 'results', releases: RELEASES })
          +screenRow('No release found')
            +appFrame(view)
              +dlMain(view)
                +releasePicker(view, { state: 'none' })
          +screenRow('Nothing downloadable · every result flagged or rejected')
            +appFrame(view)
              +dlMain(view)
                +releasePicker(view, { state: 'rejected', releases: ALL_REJECTED })

  +mockSection('dialogs', 'Dialogs', 'Each one names the object and the consequence. The destructive one keeps its cancel as “Keep it”.')
    +viewports('movie-dialogs-viewport')
      each view in ['desktop', 'mobile']
        - const phone = view === 'mobile'
        - const height = phone ? 760 : 640
        +viewportPanel(view)
          +screenRow('Import dialog · needs attention')
            +appFrame(view, { height: height })
              +dlBar(view, { active: 'library' })
              +dlMain(view)
                +movieHeader(view, 'needs_attention')
              +dialog({ title: 'Import this download', confirm: 'Import', cancel: 'Cancel' })
                p(class='mb-3') The bytes are already down — Radarr just couldn’t match the file to the title. Pick what to import, or discard.
                fieldset(class='flex flex-col gap-2')
                  legend(class='mb-1 text-label text-ink-3 uppercase') File to import
                  each file in IMPORT_FILES
                    div(class='flex flex-col gap-0.5 rounded-md border border-line bg-bg-sunk p-2.5')
                      +radio({ name: `import-${view}`, label: file.name, checked: file.checked })(class='break-all')
                      span(class='pl-[26px] font-mono text-mono-sm text-ink-3')= file.detail
                      if file.sample
                        span(class='pl-[26px] text-cap text-ink-3') Marked as a sample. Informational only — a manual import ignores it.
                +note('warn', 'Radarr said:')(class='mt-3')
                  = IMPORT_REJECTION
                div(class='mt-3')
                  +btn({ variant: 'bad', size: 'sm', label: 'Discard', icon: 'trash' })
          +screenRow('Discard confirm · from the import dialog')
            +appFrame(view, { height: 420 })
              +dlBar(view, { active: 'library' })
              +dlMain(view)
                +movieHeader(view, 'needs_attention')
              +dialog({ title: 'Discard this download?', confirm: 'Discard', cancel: 'Keep it', destructive: true })
                | Removes it from the download client, files and all, and cancels the job. Nothing is blocklisted, so a Retry afterwards can grab the same release again.
          +screenRow('Delete confirm')
            +appFrame(view, { height: 420 })
              +dlBar(view, { active: 'library' })
              +dlMain(view)
                +movieHeader(view, 'available')
                  +libraryActions(view)
              +dialog({ title: 'Delete “Salt & Ceremony”?', confirm: 'Delete', cancel: 'Keep it', destructive: true })
                | Removes this movie’s file from the library and frees 2.1 GB, and removes the movie from Radarr. It can be requested again later.
          +screenRow('Report a bad file')
            +appFrame(view, { height: height })
              +dlBar(view, { active: 'library' })
              +dlMain(view)
                +movieHeader(view, 'available')
                  +libraryActions(view)
                +releasePicker(view, { state: 'results', releases: RELEASES })
              +dialog({ title: 'What’s wrong with this file?', confirm: 'Report problem', cancel: 'Cancel' })
                fieldset(class='flex flex-col gap-2.5')
                  legend(class='sr-only') What’s wrong with this file?
                  each reason, i in REASONS
                    +radio({ name: `report-${view}`, label: reason, checked: i === 0 })
                p(class='mt-3 text-cap text-ink-3') This app won’t pick this release again. Radarr and Sonarr can still grab it from their own interfaces.
          +screenRow('Reported · the release row after')
            +appFrame(view)
              +dlMain(view)
                +card()(class='flex flex-wrap items-center gap-x-3 gap-y-2')
                  +badge({ tone: 'mute', label: 'Reported' })
                  span(class='min-w-0 flex-1 text-cap text-ink-3') This app won’t pick this release again. Radarr and Sonarr can still grab it from their own interfaces.
                  +btn({ variant: 'ghost', size: 'sm', label: 'Undo report' })

  +mockSection('boundaries', 'Loading, not found, error', 'The route’s own loading skeleton, a movie Radarr has never heard of, and the error boundary.')
    +viewports('movie-boundaries-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +screenRow('Loading · the page’s own geometry')
            +appFrame(view)
              +dlBar(view, { active: 'library' })
              +dlMain(view)
                +movieSkeleton(view)
          +screenRow('Degraded · Radarr didn’t answer')
            +appFrame(view)
              +dlBar(view, { active: 'library' })
              +dlMain(view)
                +note('warn', 'Radarr didn’t answer.')(class='mb-4')
                  | This movie’s title and details are missing — only its id is known. Trying again in a moment usually fixes it.
                +movieHeader(view, 'absent')(class='opacity-60')
          +screenRow('Not found')
            +appFrame(view)
              +dlBar(view, { active: 'library' })
              +dlMain(view, { narrow: true })
                +boundaryNotFound(view, { title: 'No such movie', body: 'Radarr has no movie at this address. Nothing has gone wrong — the link was probably mistyped, or the movie was removed.', action: 'Back to library' })
          +screenRow('Error · movie.tsx error boundary')
            +appFrame(view)
              +dlBar(view, { active: 'library' })
              +dlMain(view, { narrow: true })
                +boundaryError(view, { title: 'This movie couldn’t be loaded', lead: 'The download service didn’t answer.', detail: 'None of this movie’s details or downloads could be read. Nothing has been changed — trying again is safe.', digest: 'digest 3482910274' })
