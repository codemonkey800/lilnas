extends ../../../../../designs/mockup-kit/page.pug

include ../mixins/download.pug

block title
  | download — video detail · UI mockups

//-
  /videos/[videoId]: a video’s permalink. There is no Radarr or Sonarr here,
  only yt-dlp, so the page is a player, a download button and the job’s
  progress. The lifecycle badge uses the same seven states, worded for a file
  rather than a library. Copy and sample data are in src/data/video-detail.mjs.

//-
  The player: a 16:9 frame over the art, a big play mark when idle and a
  control bar when playing. Not a design for a video element — the controls
  are the browser's; this draws the chrome around the picture.
mixin videoPlayer(view, p)
  - const phone = view === 'mobile'
  div(class='relative aspect-video w-full overflow-hidden rounded-lg border border-line bg-bg-sunk')&attributes(attributes)
    +poster({ shape: 'wide', v: VIDEO.v, src: VIDEO.art, radius: 'rounded-none', play: !p.playing, playSize: phone ? 40 : 56 })(class='absolute inset-0 size-full')
    div(class='absolute inset-x-0 bottom-0 flex items-center gap-3 bg-linear-to-t from-black/70 to-transparent px-4 pt-8 pb-3' role='group' aria-label='Video player controls')
      button(type='button' aria-label=p.playing ? 'Pause' : 'Play' class='grid size-8 place-items-center rounded-md text-ink hover:bg-white/10')
        +icon(p.playing ? 'pause' : 'play', 18)
      div(
        class='relative flex h-3 min-w-0 flex-1 items-center'
        role='slider'
        aria-label='Seek'
        aria-valuenow=p.pct
        aria-valuemin='0'
        aria-valuemax='100'
      )
        div(class='h-[3px] w-full overflow-hidden rounded-full bg-ink/25')
          div(class='h-full rounded-full bg-accent' style=`width: ${p.pct}%`)
        span(class='absolute size-3 -translate-x-1/2 rounded-full bg-ink' style=`left: ${p.pct}%`)
      span(class='shrink-0 font-mono text-mono-sm text-ink tabular-nums')= p.time
      unless phone
        button(type='button' aria-label='Mute' class='grid size-8 place-items-center rounded-md text-ink hover:bg-white/10')
          +icon('volume', 18)
      button(type='button' aria-label='Fullscreen' class='grid size-8 place-items-center rounded-md text-ink hover:bg-white/10')
        +icon('expand', 18)

mixin videoHeader(view, state, opts)
  - opts = opts || {}
  - const phone = view === 'mobile'
  header(class='flex flex-col gap-4')&attributes(attributes)
    div(class='flex flex-col gap-1')
      h1(class='text-h1 text-balance')= VIDEO.title
      p(class='text-sm text-ink-3')= VIDEO.meta
    +lifecycle(opts.note)
      +mediaBadge(state, 'video')
    block

mixin videoActions(view, kind)
  +actionRow(view)
    case kind
      when 'absent'
        +btn({ variant: 'accent', label: 'Download', icon: 'download' })
        +btn({ variant: 'ghost', label: 'View original post', iconEnd: 'external' })
      when 'available'
        +btn({ variant: 'accent', label: 'Save to device', iconEnd: 'device' })
        +btn({ variant: 'bad', label: 'Delete', iconEnd: 'trash' })
        +btn({ variant: 'ghost', label: 'View original post', iconEnd: 'external' })
      default
        +btn({ variant: 'outline', label: 'Download', icon: 'download' })
        +btn({ variant: 'ghost', label: 'View original post', iconEnd: 'external' })

mixin videoFacts(view)
  section(class='mt-8')
    h2(class='mb-3 text-h2') Details
    dl(class=['grid gap-x-6 gap-y-4', view === 'mobile' ? 'grid-cols-1' : 'grid-cols-3'])
      each item in DETAILS
        +fact(item[0], item[1], item[2])
      div(class='min-w-0')
        dt(class='text-label text-ink-3 uppercase') Tags
        dd(class='mt-1 flex flex-wrap gap-1.5')
          each tag in TAGS
            +badge({ tone: 'mute', label: tag })
  section(class='mt-8')
    h2(class='mb-3 text-h2') File
    dl(class=['grid gap-x-6 gap-y-4', view === 'mobile' ? 'grid-cols-1' : 'grid-cols-3'])
      each item in FILE
        +fact(item[0], item[1], item[2])

mixin videoState(view, key, kind)
  - const s = STATES[key]
  +appFrame(view)
    +dlMain(view)
      +videoHeader(view, key, { note: s.note })
        +videoActions(view, kind || 'other')
      if s.attempts
        +attempts(view, s.attempts)

mixin videoSkeleton(view)
  - const phone = view === 'mobile'
  div(aria-busy='true')
    +skeleton()(class='mb-2 h-6 w-3/5')
    +skeleton()(class='mb-4 h-3.5 w-2/5')
    +skeleton()(class='mb-4 h-6 w-28 rounded-full')
    +skeleton()(class='mb-8 h-9 w-40 rounded-md')
    +skeleton()(class='aspect-video h-auto w-full rounded-lg')
    div(class=['mt-8 grid gap-x-6 gap-y-4', phone ? 'grid-cols-1' : 'grid-cols-3'])
      each n in [1, 2, 3, 4, 5, 6]
        div(class='flex flex-col gap-2')
          +skeleton()(class='h-3 w-16')
          +skeleton()(class='h-3.5 w-28')

block content
  +mockHead({ back: true, eyebrow: 'download · /videos/[videoId]', title: 'Video detail' })
    p A video’s permalink: the player, the file’s facts and a download button, with the job’s progress inline. No Radarr or Sonarr here — only yt-dlp — so a failure reads as the source’s fault, and the original post is one link away.
    +jumpNav([['Default', 'default'], ['Player', 'player'], ['Job states', 'states'], ['Dialogs', 'dialogs'], ['Boundaries', 'boundaries']])(class='mt-4')

  +mockSection('default', 'Downloaded', 'The page at rest: watch it, save a copy, delete it or open the post it came from.')
    +viewports('video-default-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +screenRow('Default · downloaded')
            +appFrame(view)
              +dlBar(view, { active: 'library' })
              +dlMain(view)
                +videoHeader(view, 'available')
                  +videoActions(view, 'available')
                  p(class='flex items-center gap-2 text-cap text-ink-3')
                    +avatar(ADDED.who[0], { size: 24 })
                    | Added by #{ADDED.who[1]} · #{ADDED.when}
                div(class='mt-8')
                  +videoPlayer(view, PLAYER.idle)
                +videoFacts(view)
                +attempts(view, ATTEMPTS_DEFAULT)

  +mockSection('player', 'Player', 'A 16:9 frame whatever the clip’s native shape. Idle shows one play mark; playing shows the control bar.')
    +viewports('video-player-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +screenRow('Player · idle')
            +appFrame(view)
              +dlMain(view)
                +videoPlayer(view, PLAYER.idle)
          +screenRow('Player · playing')
            +appFrame(view)
              +dlMain(view)
                +videoPlayer(view, PLAYER.playing)

  +mockSection('states', 'Job states', 'The badge follows the media state, and the Attempts list underneath carries whatever is in flight or went wrong. Only the newest attempt offers Retry.')
    +viewports('video-states-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +screenRow('State · not downloaded')
            +videoState(view, 'absent', 'absent')
          +screenRow('State · downloading')
            +videoState(view, 'downloading')
          +screenRow('State · processing')
            +videoState(view, 'importing')
          +screenRow('State · paused')
            +videoState(view, 'paused')
          +screenRow('Attempt · failed')
            +appFrame(view)
              +dlMain(view)
                +videoHeader(view, 'absent', { note: 'Ready to grab whenever.' })
                  +videoActions(view, 'absent')
                +attempts(view, STATES.failed.attempts)
          +screenRow('Attempt · cancelled')
            +appFrame(view)
              +dlMain(view)
                +videoHeader(view, 'absent', { note: 'Ready to grab whenever.' })
                  +videoActions(view, 'absent')
                +attempts(view, STATES.cancelled.attempts)
          +screenRow('Attempt · a link yt-dlp doesn’t recognise')
            +appFrame(view)
              +dlMain(view)
                +videoHeader(view, 'absent')
                  +note('bad', UNRECOGNISED.lead)(class='max-w-[480px]')
                    = UNRECOGNISED.body
                  +videoActions(view, 'absent')
                +attempts(view, [{ job: 'failed', who: ['SR', 'Sam'], when: '1m ago' }])

  +mockSection('dialogs', 'Delete confirm', 'Names the video and says what stays.')
    +viewports('video-dialogs-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +screenRow('Delete confirm')
            +appFrame(view, { height: view === 'mobile' ? 520 : 420 })
              +dlBar(view, { active: 'library' })
              +dlMain(view)
                +videoHeader(view, 'available')
                  +videoActions(view, 'available')
              +dialog({ title: 'Delete “How to kettlebell swing (in 3 minutes)”?', confirm: 'Delete', cancel: 'Keep it', destructive: true })
                = DELETE_BODY

  +mockSection('boundaries', 'Loading, not found, error', 'The page’s own geometry while it loads; a video that never ran or whose files are gone; the error boundary.')
    +viewports('video-boundaries-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +screenRow('Loading · the page’s own geometry')
            +appFrame(view)
              +dlBar(view, { active: 'library' })
              +dlMain(view)
                +videoSkeleton(view)
          +screenRow('Not found · not-found.tsx')
            +appFrame(view)
              +dlBar(view, { active: 'library' })
              +dlMain(view, { narrow: true })
                +boundaryNotFound(view, { title: 'No such video', body: 'Nothing has been downloaded under this address. A video only gets a page once somebody asks for it, so either this one never ran or its files have been removed — paste the link in the search field at the top to start it again.', action: 'Back to library' })
          +screenRow('Error · error.tsx')
            +appFrame(view)
              +dlBar(view, { active: 'library' })
              +dlMain(view, { narrow: true })
                +boundaryError(view, { title: 'This video couldn’t be loaded', lead: 'The download service didn’t answer.', detail: 'None of this video’s details or downloads could be read. Nothing has been changed — trying again is safe.', digest: 'digest 2290311847' })
