extends ../../../../../designs/mockup-kit/page.pug

include ../mixins/download.pug

block title
  | download — search · UI mockups

//-
  /search: movie and show discovery. The one screen whose hero IS the search
  field, so its app bar omits the nav search. Every state is a captioned row at
  both widths. Copy and sample data are in src/data/search.mjs.

//- The hero in layout: the headline, the field and a one-line hint.
mixin searchHero(view, opts)
  - opts = opts || {}
  +hero(view, { title: 'Search movies and shows', value: opts.value === undefined ? QUERY : opts.value, hint: view === 'mobile' ? HINT_MOBILE : HINT, placeholder: 'Search a title…', button: 'Search' })

//- Result count, the grid/list toggle, Sort and Filters.
mixin toolbar(view, opts)
  - opts = opts || {}
  - const phone = view === 'mobile'
  - const sorts = SORTS.map((label, i) => ({ label: label, selected: i === 0 }))
  div(class=['mb-4 flex items-center justify-between', phone ? 'flex-wrap gap-2' : 'gap-4']).relative
    span(class='text-sm text-ink-3')= opts.count
    div(class='flex items-center gap-2')
      if !opts.noView
        +segmented([{ value: 'grid', label: 'Grid', icon: 'grid-fill' }, { value: 'list', label: 'List', icon: 'list' }], opts.list ? 'list' : 'grid')
      +sortMenu(sorts, { open: opts.sortOpen, label: phone ? 'Sort' : 'Sort: Relevance' })
      div(class=['relative', opts.filtersOpen ? 'z-20' : ''])
        +filtersBtn({ count: opts.applied, open: opts.filtersOpen })
        if opts.filtersOpen && !phone
          div(class='absolute top-[calc(100%+8px)] right-0 w-[460px]')
            +filters(opts.invalid, false)
    if opts.filtersOpen && phone
      div(class='absolute inset-x-0 top-[calc(100%+8px)] z-20')
        +filters(opts.invalid, true)

//- The filter panel. An inverted year range shows its error and disables the apply button.
mixin filters(invalid, phone)
  +filterPanel
    +filterGrid
      +filterGroup('Genre')(class='@min-[400px]:col-span-2')
        div(class='flex flex-wrap gap-2')
          each genre, i in phone ? GENRES.slice(0, GENRES_MOBILE) : GENRES
            +toggleChip(genre, i === 0)
      +filterGroup('Release year')(class='@min-[400px]:col-span-2')
        div(class='flex items-center gap-2')
          +input({ value: invalid ? '2015' : '1999', mono: true, error: invalid })(class='w-24' aria-label='From year')
          span(class='text-ink-3') –
          +input({ value: invalid ? '1998' : '2012', mono: true, error: invalid })(class='w-24' aria-label='To year')
        if invalid
          p(class='flex items-center gap-1.5 text-xs text-bad')
            +icon('alert', 12)
            | Start year must be before end year
    +filterFoot
      +btn({ variant: 'ghost', size: 'sm', label: 'Clear all' })
      +btn({ variant: 'accent', size: 'sm', label: invalid ? 'Show results' : 'Show 8 results', disabled: invalid })

//- The results as poster cards; a phone shows the first four.
mixin resultGrid(view)
  - const phone = view === 'mobile'
  div(class=['grid gap-4 stagger', phone ? 'grid-cols-2' : 'grid-cols-[repeat(auto-fill,minmax(148px,1fr))]'])
    each entry in phone ? RESULTS.slice(0, 4) : RESULTS
      +resultCard(entry)

//- The results as a list: a row each, with the year and genre alongside.
mixin resultList(view)
  - const phone = view === 'mobile'
  div(class='flex flex-col gap-2 stagger')
    each entry in phone ? RESULTS.slice(0, 4) : RESULTS
      +resultRow(entry)
        if !phone
          span(class='w-40 truncate text-cap text-ink-3')= entry.genre
        span(class='w-12 text-right text-sm tabular-nums')= entry.year
        +badge({ tone: 'mute', label: entry.kind === 'show' ? 'Show' : 'Movie' })

//- Load more: the one outline button under a result set.
mixin loadMore(state)
  div(class='mt-6 flex flex-col items-center gap-2')
    if state === 'pending'
      +btn({ variant: 'outline', label: 'Loading more', loading: true })
    else
      +btn({ variant: 'outline', label: 'Load more' })
    if state === 'failed'
      p(class='flex items-center gap-1.5 text-xs text-bad')
        +icon('alert', 12)
        | Couldn’t load more results — try again

//- The shape of the answer before the answer arrives.
mixin loadingGrid(view)
  - const phone = view === 'mobile'
  div(class=['grid gap-4', phone ? 'grid-cols-2' : 'grid-cols-[repeat(auto-fill,minmax(148px,1fr))]'] aria-busy='true')
    each w in phone ? GRID_SKELETONS.slice(0, 4) : GRID_SKELETONS.slice(0, 8)
      div(class='flex flex-col gap-2 rounded-lg border border-line bg-surface p-2.5')
        +skeleton()(class='aspect-[2/3] w-full rounded-md')
        +skeleton()(class='h-3.5' style=`width: ${w[0]}`)
        +skeleton()(class='h-3' style=`width: ${w[1]}`)

mixin loadingList(view)
  - const phone = view === 'mobile'
  div(class='flex flex-col gap-2' aria-busy='true')
    each w in phone ? LIST_SKELETONS.slice(0, 4) : LIST_SKELETONS
      div(class='flex items-center gap-3 rounded-lg border border-line bg-surface p-2.5')
        +skeleton('poster')(class='h-[72px] w-12 shrink-0')
        div(class='flex flex-1 flex-col gap-2')
          +skeleton()(class='h-3.5' style=`width: ${w}`)
          +skeleton()(class='h-3 w-24')

//- One framed state. `scrim` dims the frame behind an open panel.
mixin searchState(view, label, opts)
  - opts = opts || {}
  +screenRow(label)
    +appFrame(view)
      +dlBar(view, { active: 'library', search: false })
      +dlMain(view)
        block
      if opts.scrim
        +frameScrim

block content
  +mockHead({ back: true, eyebrow: 'download · /search', title: 'Search' })
    p Movie and show discovery, reachable from the app bar on every other page. Title, year, cast or genre, filtered by genre and release year, with movies and shows interleaved in one set of results. Nothing downloads from here: every result opens its detail page.

  +mockSection('search', 'Search', 'The hero is the search field, so the app bar has no nav search of its own.')
    +viewports('search-viewport')
      each view in ['desktop', 'mobile']
        - const phone = view === 'mobile'
        - const count = phone ? '8 results' : '8 results for “the office”'
        - const chips = [['Comedy', 'Remove genre filter'], ['1999–2012', 'Remove release year filter']]
        +viewportPanel(view)
          +searchState(view, 'Empty query · the hero is the whole invitation')
            +searchHero(view, { value: '' })

          +searchState(view, 'Short query · note')
            +searchHero(view, { value: 'o' })
            +note('accent', 'Keep typing.')(class='reveal')
              | A search needs at least two characters.

          +searchState(view, 'Invalid year range · note')
            +searchHero(view)
            +note('bad', 'Start year must be before end year.')(class='reveal')
              | Widen the release-year range and the results will come back.

          +searchState(view, 'Degraded sources · note above the count')
            +searchHero(view)
            +note('warn', 'Showing movies only.')(class='mb-4')
              | Sonarr didn’t answer, so these results come from Radarr alone. Try again shortly for the full set.
            +toolbar(view, { count: phone ? '4 results' : '4 results for “the office”' })
            +resultGrid(view)

          +searchState(view, 'No matches')
            +searchHero(view, { value: 'xyzzyqqq' })
            +toolbar(view, { count: phone ? '0 results' : '0 results for “xyzzyqqq”', noView: true })
            +note('accent', 'No matches for “xyzzyqqq.”')(class='reveal')
              | Double-check the spelling, or try browsing the #[a(class='text-ink underline' href='gallery.html') gallery] instead.

          +searchState(view, 'Results · grid view')
            +searchHero(view)
            +toolbar(view, { count: count })
            +resultGrid(view)

          +searchState(view, 'Results · list view')
            +searchHero(view)
            +toolbar(view, { count: count, list: true })
            +resultList(view)

          +searchState(view, 'Sort menu open')
            +searchHero(view)
            +toolbar(view, { count: count, sortOpen: true })
            +resultGrid(view)

          +searchState(view, 'Filter panel open', { scrim: true })
            +searchHero(view)
            +toolbar(view, { count: count, filtersOpen: true, applied: 2 })
            +appliedFilters(chips)(class='mb-4')
            +resultGrid(view)

          +searchState(view, 'Filter panel · invalid year range', { scrim: true })
            +searchHero(view)
            +toolbar(view, { count: count, filtersOpen: true, applied: 2, invalid: true })
            +appliedFilters(chips)(class='mb-4')
            +resultGrid(view)

          +searchState(view, 'Applied filters · load more')
            +searchHero(view)
            +toolbar(view, { count: count, applied: 2 })
            +appliedFilters(chips)(class='mb-4')
            +resultGrid(view)
            +loadMore()

          +stateRow('Load more', { stack: true })(class='w-full')
            +stateCell('Rest')
              +loadMore()(class='mt-0')
            +stateCell('Loading')
              +loadMore('pending')(class='mt-0')
            +stateCell('Failed')
              +loadMore('failed')(class='mt-0')

          +searchState(view, 'Loading · grid')
            +searchHero(view, { value: 'the offic' })
            +loadingGrid(view)

          +searchState(view, 'Loading · list')
            +searchHero(view, { value: 'the offic' })
            +loadingList(view)
