extends ../layout/page.pug

block title
  | Admin dashboard — download UI mockups · lilnas

//-
  Admin-only. Same activity feed regular users see, but with every attribution
  unmasked — the difference between this page and downloads-activity.html is
  the requester column, not the layout.

//- Feed thumbnail: same treatment as downloads-activity.
mixin rowArt(row)
  +poster({ shape: row.shape, v: row.v, src: row.art, radius: 'rounded-xs' })(
    class=row.shape === 'wide' ? 'w-[52px]' : 'w-[34px]'
  )
    if row.icon === 'play'
      +icon('play')(class='relative z-1 h-[14px] w-[14px] text-ink-3')

//-
  Who asked for it. The eye-slash means "this row is hidden from everyone
  else" — it marks the privilege, not the person. Always linkable: this
  whole page is admin-only, so every requester on it is someone the viewer
  is allowed to open.
mixin requester(row, size)
  +avatar(row.who[0], { ring: row.you, href: 'profile.html' })&attributes(attributes)
  a(class='font-mono text-mono-sm text-ink-3 hover:text-ink hover:underline' href='profile.html')= row.who[1]
  if row.hiddenFromOthers
    span(class='inline-flex shrink-0 text-ink-4' title='Hidden from other users')
      +icon('eye-slash')(class='h-3 w-3')

mixin rowStatus(row, label)
  +chip({ label: row.live ? null : label || row.state, tone: row.tone })&attributes(attributes)
    if row.live
      +dot('live')
      = label || row.state

//- Headline number. Mono and tabular — it changes, so it must not jitter.
mixin statTile(stat, mobile)
  div(class='flex flex-col gap-[7px] rounded-lg border border-line bg-surface px-5 pt-[18px] pb-5')
    span(class='font-mono text-label tracking-[0.11em] uppercase text-ink-4')= mobile && stat.labelMobile ? stat.labelMobile : stat.label
    - const valueClass = `font-mono ${mobile ? 'text-[26px]' : 'text-[32px]'} leading-[1.1] font-semibold tracking-[-0.02em] tabular-nums`
    if stat.live
      span(class='flex items-center gap-2')
        +dot('live')
        span(class=[valueClass, 'text-ok'])= stat.value
    else
      span(class=valueClass)
        = stat.value
        if stat.unit
          |
          span(class=mobile ? 'text-[14px] text-ink-3' : 'text-[16px] text-ink-3')= stat.unit
    if stat.bar
      +bar(stat.bar)(class='mt-px')
    span(class='font-mono text-mono-sm text-ink-4')= mobile ? stat.footMobile : stat.foot

//- One line of the leaderboard. Linkable for the same reason `requester` is
    — the whole page is admin-only.
mixin lbRow(entry)
  div(class='flex items-center gap-3 px-1 py-2.5 [&+&]:border-t [&+&]:border-line-soft')
    span(class='w-4 shrink-0 text-center font-mono text-mono-sm text-ink-4')= entry.rank
    +avatar(entry[0], { ring: entry[3], href: 'profile.html' })
    a(class='flex-1 text-sm hover:text-ink hover:underline' href='profile.html')= entry[1]
    span(class=['font-mono text-mono tabular-nums', entry[3] ? 'text-uv-hi' : 'text-ink-3'])= entry[2]

block content
  +mockHead({ eyebrow: 'lilnas · download', title: 'Admin dashboard' })
    p(class='max-w-[62ch] text-sm text-ink-3')
      | System-wide metrics, the same activity feed regular users see but with every attribution unmasked —
      | including videos hidden from everyone else — a top-downloaders leaderboard, and the full audit trail.
      | Admin-only.

  div(class='vp-scope')
    +viewportToggle('viewport')(class='mb-8' role='radiogroup' aria-label='Viewport')

    //- ── desktop ────────────────────────────────────────────────────────
    +viewportPanel('desktop')
      +appFrame('desktop')
        +appBar('desktop')
          div(class='flex min-w-0 flex-1 items-center gap-[14px]')
            +doorplate('Download')(href='https://lilnas.io')
            +navsearch({ placeholder: 'Search or paste a link…' })
          span(class='flex shrink-0 items-center gap-2.5')
            +chip({ label: 'admin', tone: 'uv' })
            +chip({ tone: 'ok' })
              +dot('live')
              | 2 running
            +avatar('JA', { ring: true, href: 'profile.html' })(class='h-[30px] w-[30px] text-[11.5px]' title='Jeremy · you')
        +appBody('desktop')
          div(class='mx-auto max-w-[1080px]')
            p(class='mb-5 text-[22px] leading-[1.25] font-[650] tracking-[-0.015em]') Admin dashboard

            div(class='mb-8 grid grid-cols-4 gap-[14px]')
              each stat in STATS
                +statTile(stat)

            div(class='mb-[14px] flex items-center justify-between')
              span(class='text-h2') Downloads activity
              +chip({ label: 'enriched', tone: 'mute' })
            +card()(class='mb-7 px-1.5 pt-1 pb-1.5')
              +dataTable
                thead
                  tr
                    th(class='w-[38%]') item
                    th type
                    th requester
                    th status
                    th progress
                    th(class='text-right!') started
                tbody(class='stagger')
                  each row in ROWS
                    tr
                      td
                        div(class='flex items-center gap-2.5')
                          +rowArt(row)
                          span(class='text-sm')= row.title
                      td
                        +mchip(row.icon, row.kind)(class='font-mono text-mono-sm text-ink-3')
                      td
                        span(class='flex items-center gap-1.5')
                          +requester(row)
                      td
                        +rowStatus(row)
                      td
                        if row.progress
                          div(class='flex w-[140px] items-center gap-2')
                            +bar(row.progress)(class='flex-1')
                            span(
                              class=['font-mono text-mono-sm tabular-nums', row.quietProgress ? 'text-ink-3' : 'text-uv-hi']
                            )= `${row.progress}%`
                        else
                          span(class='font-mono text-mono-sm text-ink-4') —
                      td(class='text-right! font-mono text-mono-sm tabular-nums text-ink-3')= row.started

            div(class='flex items-start gap-5')
              div(class='flex-[0_0_320px]')
                p(class='mb-[14px] text-h2') Top downloaders
                +card()(class='px-3 pt-1 pb-2')
                  div(class='flex flex-col stagger')
                    each entry, i in LEADERBOARD
                      - entry.rank = i + 1
                      +lbRow(entry)
              div(class='min-w-0 flex-1')
                p(class='mb-[14px] text-h2') Audit log
                +card({ sunk: true })(class='px-2.5 py-1')
                  div(class='flex flex-col stagger')
                    each line in AUDIT
                      div(
                        class='grid grid-cols-[70px_72px_1fr] items-baseline gap-3 rounded-xs px-2.5 py-[7px] font-mono text-mono-sm transition-colors duration-[120ms] ease-uv hover:bg-surface-2'
                      )
                        span(class='tabular-nums text-ink-4')= line.at
                        span(class=['text-[10px] font-semibold tracking-[0.08em]', line.tone])= line.level
                        span(class='text-ink-3')= line.what

    //- ── mobile ─────────────────────────────────────────────────────────
    +viewportPanel('mobile')
      +appFrame('mobile')
        +appBar('mobile')
          +doorplate('Download')(href='https://lilnas.io')
          span(class='flex shrink-0 items-center gap-1.5')
            +chip({ label: 'admin', tone: 'uv' })
            +btn({ variant: 'ghost', icon: 'search' })(class='h-[30px] w-[30px] p-0' aria-label='Search')
            +accountLink('JA')
        +appBody('mobile')
          p(class='mb-4 text-[20px] leading-[1.25] font-[650] tracking-[-0.015em]') Admin dashboard

          div(class='mb-6 grid grid-cols-2 gap-[14px]')
            each stat in STATS
              +statTile(stat, true)

          div(class='mb-3 flex items-center justify-between')
            span(class='text-h2') Downloads activity
            +chip({ label: 'enriched', tone: 'mute' })
          +card()(class='mb-[26px] px-3 py-1')
            div(class='flex flex-col stagger')
              each row in ROWS
                div(class='flex items-center gap-3 py-[13px] [&+&]:border-t [&+&]:border-line-soft')
                  +rowArt(row)
                  div(class='flex min-w-0 flex-1 flex-col gap-[5px]')
                    span(class='flex items-center justify-between gap-2')
                      span(class='flex-1 text-sm')= row.short || row.title
                      span(class='font-mono text-mono-sm tabular-nums text-ink-4')= row.started
                    span(class='flex items-center gap-1.5')
                      +requester(row)(class='h-[18px] w-[18px] text-[8px]')
                    +rowStatus(row, row.mobileState || (row.live ? `${row.progress}%` : row.state))(
                      class='h-5 self-start'
                    )

          p(class='mb-3 text-h2') Top downloaders
          +card()(class='mb-[26px] px-3 pt-1 pb-2')
            div(class='flex flex-col stagger')
              each entry, i in LEADERBOARD
                - entry.rank = i + 1
                +lbRow(entry)

          p(class='mb-3 text-h2') Audit log
          +card({ sunk: true })(class='px-2.5 py-1')
            div(class='flex flex-col stagger')
              each line in AUDIT
                div(class='flex flex-col gap-1 rounded-xs px-2.5 py-[9px] font-mono text-mono-sm')
                  span(class='flex items-baseline gap-2.5')
                    span(class='tabular-nums text-ink-4')= line.at
                    span(class=['text-[10px] font-semibold tracking-[0.08em]', line.tone])= line.level
                  span(class='text-ink-3')= line.whatMobile || line.what
