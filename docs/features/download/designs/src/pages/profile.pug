extends ../../../../../designs/mockup-kit/page.pug

include ../mixins/download.pug

block title
  | download — profile · UI mockups

//-
  /profile: a computed view over one person's jobs, not a stored entity, so
  every state — your own, an admin looking at someone else's, an empty one,
  the filter sequence — goes through the same markup fed a different
  PROFILES entry. Copy and sample data are in src/data/profile.mjs.

//- Header: avatar, email (with a "you" badge on your own), and first/last download in mono.
mixin profileHeader(profile)
  div(class='mb-6 flex items-center gap-4')
    if profile.empty
      +maskedAvatar(64)
    else
      +avatar(profile.initials, { size: 64, you: profile.you })
    div(class='min-w-0')
      p(class='mb-1 flex flex-wrap items-center gap-2 text-h1')
        span(class='break-all')= profile.email
        if profile.you
          +badge({ tone: 'accent', label: 'You' })
      p(class='font-mono text-mono-sm text-ink-3')
        if profile.firstDownloadAt
          | #{'first ' + profile.firstDownloadAt} · #{'last ' + profile.lastDownloadAt}
        else
          | no downloads yet

//- The lifetime tile: one big number, never mono (it's a quantity).
mixin lifetime(profile)
  +card()(class='mb-6 flex w-fit min-w-[168px] flex-col gap-1.5')
    span(class='text-label text-ink-3 uppercase') Lifetime downloads
    span(class='text-[32px] leading-[1.1] font-semibold tracking-tight tabular-nums')= profile.total

//-
  The totals: one chip per type and per status that ever occurred. They are
  the page's filter — a chip you pick turns accent, and the history below is
  scoped to it. OR within a group, AND across groups.
mixin totals(profile)
  - const types = profile.activeTypes || []
  - const statuses = profile.activeStatuses || []
  div(class='mb-6 flex flex-col gap-4')
    div(class='flex flex-col gap-2')
      span(class='text-label text-ink-3 uppercase') By type
      div(class='flex flex-wrap gap-2')
        each t in profile.totalsByType
          +toggleChip(t.name, types.includes(t.name))
            span(class='order-last font-mono text-mono-sm text-ink-3')= t.count
    div(class='flex flex-col gap-2')
      span(class='text-label text-ink-3 uppercase') By status
      div(class='flex flex-wrap gap-2')
        each s in profile.totalsByStatus
          +toggleChip(s.name, statuses.includes(s.name))
            +statusDot(s.tone)
            span(class='order-last font-mono text-mono-sm text-ink-3')= s.count

//- Jobs per day, newest on the right. Zero days keep a hairline tick so gaps read as gaps.
mixin trendBars(profile)
  - const max = Math.max.apply(null, profile.trend.map(d => d.count).concat([1]))
  div(class='mb-7 flex flex-col gap-2')
    span(class='text-label text-ink-3 uppercase')= `Last ${profile.windowDays} days`
    if profile.trend.length === 0
      +note('accent', 'No activity in this window.')
        | Downloads from the past #{profile.windowDays} days will show up here as bars.
    else
      div(
        class='flex h-16 items-end gap-0.5'
        role='img'
        aria-label=`${profile.total} downloads over the last ${profile.windowDays} days`
      )
        each day in profile.trend
          div(
            class=['flex-1 rounded-t-xs', day.count ? 'bg-accent' : 'bg-line']
            style=`height: ${day.count ? Math.round((day.count / max) * 100) : 4}%`
            title=`${day.label} · ${day.count}`
          )
      div(class='flex justify-between font-mono text-mono-sm text-ink-3')
        span= profile.trend[0].label
        span= profile.trend[profile.trend.length - 1].label

mixin profileHistory(view, profile)
  h2(class='mb-3 text-h2') Download history
  if profile.history.length
    +dataList(HISTORY_COLS, profile.history, { view: view })
  else if profile.empty
    +emptyState('No downloads yet', 'This person’s downloads will show up here once they start one.', 'Back to library')
  else
    +emptyState('No downloads match these filters', 'This person has downloads — none fit this combination. Clear a filter to widen the view.', 'Clear filters')

mixin profileBody(view, profile)
  h1(class='sr-only') User profile
  +profileHeader(profile)
  +lifetime(profile)
  if !profile.empty
    +totals(profile)
    if profile.activeTypes || profile.activeStatuses
      - const chips = (profile.activeTypes || []).concat(profile.activeStatuses || []).map(l => [l, `Remove ${l} filter`])
      +appliedFilters(chips)(class='mb-5')
  +trendBars(profile)
  +profileHistory(view, profile)

mixin profileLoading(view)
  - const phone = view === 'mobile'
  div(aria-busy='true')
    div(class='mb-6 flex items-center gap-4')
      +skeleton('avatar')(class='size-16')
      div(class='flex flex-col gap-2')
        +skeleton()(class='h-5 w-56')
        +skeleton()(class='h-3 w-40')
    +card()(class='mb-6 flex w-fit min-w-[168px] flex-col gap-3')
      +skeleton()(class='h-3 w-28')
      +skeleton()(class='h-8 w-14')
    div(class='mb-6 flex flex-wrap gap-2')
      each w in [88, 96, 80, 104, 92]
        +skeleton()(class='h-8 rounded-md' style=`width: ${w}px`)
    +skeleton()(class=['mb-7 w-full', phone ? 'h-16' : 'h-20'])
    h2(class='mb-3 text-h2') Download history
    div(class='flex flex-col gap-2')
      each n in [1, 2, 3, 4]
        div(class='flex items-center gap-4 rounded-lg border border-line bg-surface p-3')
          +skeleton()(class='h-3.5 w-2/5')
          +skeleton()(class='ml-auto h-6 w-24 rounded-full')

mixin profileState(view, label, opts)
  - opts = opts || {}
  +screenRow(label)
    +appFrame(view)
      +dlBar(view, { active: 'library', admin: opts.admin })
      +dlMain(view)
        block

block content
  +mockHead({ back: true, eyebrow: 'download · /profile', title: 'Profile' })
    p One person’s lifetime totals, a trend of the last 30 days and their download history. You can open your own; an admin can open anyone’s. Anyone else gets the not-authorized page.

  +mockSection('profile', 'Profile', 'The totals double as the filter: pick a type or a status and the history below follows.')
    +viewports('profile-viewport')
      each view in ['desktop', 'mobile']
        +viewportPanel(view)
          +profileState(view, 'Not authorized · someone else’s profile')
            +notAuthorized(view, { page: 'User profile', body: 'Only an admin can open another person’s profile. Nothing has gone wrong — yours is under your avatar.' })

          +profileState(view, PROFILES[0].label)
            +profileBody(view, PROFILES[0])

          +profileState(view, PROFILES[1].label)
            +profileBody(view, PROFILES[1])

          +profileState(view, PROFILES[2].label)
            +profileBody(view, PROFILES[2])

          +profileState(view, PROFILES[3].label)
            +profileBody(view, PROFILES[3])

          +profileState(view, PROFILES[4].label, { admin: true })
            +profileBody(view, PROFILES[4])

          +profileState(view, PROFILES[5].label, { admin: true })
            +profileBody(view, PROFILES[5])

          +profileState(view, 'Loading · the page’s own geometry')
            +profileLoading(view)

          +profileState(view, 'Error · the profile didn’t load')
            +boundaryError(view, { title: 'This profile didn’t load', lead: 'The download service didn’t answer.', detail: 'Nothing has changed — the numbers just couldn’t be read. Try again in a minute.' })
