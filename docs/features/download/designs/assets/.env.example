# Copy this file to .env and fill in EMBY_API_KEY (see README.md).
# .env is gitignored; this example file is committed.

EMBY_URL=https://emby.lilnas.io
EMBY_API_KEY=key

# Optional — override which videos yt-dlp grabs thumbnails for.
# Anything yt-dlp accepts works: a search (ytsearch1:...), or a direct URL.
# Quoted: fetch-assets.sh sources this file, and bash splits unquoted
# multi-word values into separate words (breaks on the first space).
YT_KETTLEBELL_QUERY="ytsearch1:kettlebell swing tutorial short"
YT_ZOO_QUERY="ytsearch1:me at the zoo first youtube video"
YT_SOURDOUGH_QUERY="ytsearch1:sourdough starter tutorial"
YT_PIPE_QUERY="ytsearch1:fixing a leaking pipe tutorial"
