extends ../../../../../designs/mockup-kit/page.pug

include ../mixins/tdr-bot.pug

block title
  | tdr-bot — Transcript · UI mockups

//-
  The transcript at 1280 and 390: a channel list (a 232px sidebar, or a
  horizontal scroller on a phone), the date range and totals, and the thread
  with the LLM calls behind each reply. Copy and sample data are in
  src/data/transcript.mjs.

mixin transcriptStates(view)
  - const width = 'max-w-[1216px]'

  +screen(view, 'Conversation', 'default')
    +tdrFrame(view, 'Transcript', { width: width })
      +transcriptPanel(view)

  +screen(view, 'Custom emojis · one the model made up', 'emojis')
    +tdrFrame(view, 'Transcript', { bare: true, width: width })
      +transcriptPanel(view, { mode: 'emojis' })

  +screen(view, 'Loading older messages', 'older')
    +tdrFrame(view, 'Transcript', { bare: true, width: width })
      +transcriptPanel(view, { mode: 'older' })

  +screen(view, 'No messages yet', 'empty')
    +tdrFrame(view, 'Transcript', { bare: true, width: width })
      +transcriptPanel(view, { mode: 'empty', active: 3 })

  +screen(view, 'Loading', 'loading')
    +tdrFrame(view, 'Transcript', { bare: true, width: width })
      +transcriptPanel(view, { mode: 'loading' })

  +screen(view, 'Error', 'error')
    +tdrFrame(view, 'Transcript', { bare: true, width: width })
      +transcriptPanel(view, { mode: 'error' })

block content
  +mockHead({ eyebrow: 'tdr-bot · transcript', title: 'Transcript', back: true })
    p Per-channel conversation history with an audit of the LLM calls behind every reply. Calls are a table at 1280 and cards at 390, drawn from one column definition; tool calls and call lists open in place. Custom emojis render as images, and one the model invented shows as a dashed red chip.

  div(class='vp-scope flex flex-col items-center gap-6')
    +viewportToggle('transcript-viewport')
    +viewportPanel('desktop')
      +jumpNav(jump, 'desktop')(class='w-full')
      +transcriptStates('desktop')
    +viewportPanel('mobile')
      +jumpNav(jump, 'mobile')(class='w-full')
      +transcriptStates('mobile')
