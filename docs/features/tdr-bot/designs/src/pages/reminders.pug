extends ../../../../../designs/mockup-kit/page.pug

include ../mixins/tdr-bot.pug

block title
  | tdr-bot — Reminders · UI mockups

//-
  Reminders at 1280 and 390: status tabs with counts, a filter, and the list
  (a table, or cards on a phone). The create / edit dialog, the cancel confirm
  and the test-send dialog follow. Copy and sample data are in
  src/data/reminders.mjs.

mixin reminderStates(view)
  - const phone = view === 'mobile'
  - const active = rows.filter(r => r.status === 'active')
  - const mixed = [rows[0], rows[5], rows[7], rows[8], rows[1]]

  +screen(view, 'Active', 'default')
    +tdrFrame(view, 'Reminders')
      +pageHead('Reminders', 'Every reminder the bot holds.')
      +reminderToolbar(view)
      +reminderList(view, active)

  +screen(view, 'All · every status badge', 'all')
    +tdrFrame(view, 'Reminders', { bare: true })
      +reminderToolbar(view, { active: 'All' })
      +reminderList(view, mixed)

  +screen(view, 'Nothing active', 'empty')
    +tdrFrame(view, 'Reminders', { bare: true })
      +reminderToolbar(view, { counts: { active: 0, completed: 2, cancelled: 2, missed: 1, all: 5 } })
      +listShell
        +emptyState(copy.empty.title, copy.empty.body, copy.empty.action)

  +screen(view, 'Search finds nothing', 'filtered')
    +tdrFrame(view, 'Reminders', { bare: true })
      +reminderToolbar(view, { active: 'All', query: 'zed' })
      +listShell
        +emptyState(copy.filtered.title, copy.filtered.body, 'Clear search')

  +screen(view, 'Loading', 'loading')
    +tdrFrame(view, 'Reminders', { bare: true })
      +reminderToolbar(view)
      +reminderSkeleton(view)

  +screen(view, 'Load error', 'load-error')
    +tdrFrame(view, 'Reminders', { bare: true })
      +note('bad', copy.loadError.lead)= copy.loadError.body

  +screen(view, 'New reminder · picking a member', 'pick')
    +tdrFrame(view, 'Reminders', { bare: true, height: phone ? 1180 : 990 })
      +reminderList(view, active.slice(0, 2))
      +reminderDialog(view, dialogs.pick)

  +screen(view, 'New reminder · recurring, next runs previewed', 'recurring')
    +tdrFrame(view, 'Reminders', { bare: true, height: phone ? 1420 : 1100 })
      +reminderList(view, active.slice(0, 2))
      +reminderDialog(view, dialogs.recurring)

  +screen(view, 'New reminder · bad cron, Create disabled', 'invalid')
    +tdrFrame(view, 'Reminders', { bare: true, height: phone ? 1280 : 980 })
      +reminderList(view, active.slice(0, 2))
      +reminderDialog(view, dialogs.invalid)

  +screen(view, 'Edit reminder', 'edit')
    +tdrFrame(view, 'Reminders', { bare: true, height: phone ? 1360 : 1080 })
      +reminderList(view, active.slice(0, 2))
      +reminderDialog(view, dialogs.edit)

  +screen(view, 'Cancel · confirm', 'cancel')
    +tdrFrame(view, 'Reminders', { bare: true, height: phone ? 560 : 440 })
      +reminderList(view, active.slice(1, 3))
      +dialog({ title: copy.cancel.title, confirm: copy.cancel.confirm, cancel: copy.cancel.cancel, destructive: true })
        = copy.cancel.body

  +stateRow('Send a test', { stack: true })(class='w-full' id='test-' + view)
    each variant in [{ label: 'Pick a date', state: undefined }, { label: 'Sent', state: 'sent' }, { label: 'No dates left', state: 'exhausted' }]
      +stateCell(variant.label)
        +demoFrame(phone ? 440 : 420)(class='w-[490px] max-w-full')
          +dialog({ title: copy.test.title, confirm: copy.test.confirm, cancel: copy.test.cancel })
            +testSendBody(copy.test, variant.state)

block content
  +mockHead({ eyebrow: 'tdr-bot · reminders', title: 'Reminders', back: true })
    p Every reminder the bot holds. Status tabs carry counts; the list is a table at 1280 and cards at 390. Active reminders pulse, completed ones are green, cancelled ones go quiet and missed ones warn. Creating and editing share one dialog with a live preview of the next three runs; cancelling confirms by name.

  div(class='vp-scope flex flex-col items-center gap-6')
    +viewportToggle('reminders-viewport')
    +viewportPanel('desktop')
      +jumpNav(jump, 'desktop')(class='w-full')
      +reminderStates('desktop')
    +viewportPanel('mobile')
      +jumpNav(jump, 'mobile')(class='w-full')
      +reminderStates('mobile')
