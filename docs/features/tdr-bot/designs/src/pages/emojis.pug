extends ../../../../../designs/mockup-kit/page.pug

include ../mixins/tdr-bot.pug

block title
  | tdr-bot — Emojis · UI mockups

//-
  The custom-emoji dictionary at 1280 and 390: filter tabs with counts, search,
  the two bulk actions with the reconcile status, and a grid of emoji cards.
  Copy and sample data are in src/data/emojis.mjs.

mixin emojiStates(view)
  - const phone = view === 'mobile'
  - const shown = phone ? rows.slice(0, 5) : rows
  - const some = [rows[0], rows[1], rows[2], rows[3]]
  - const running = [rows[2], rows[3], rows[8], rows[0]]

  +screen(view, 'Populated', 'default')
    +tdrFrame(view, 'Emojis')
      +pageHead('Emojis', 'What each custom emoji looks like and means, so the bot can use them.')
      +emojiToolbar(view)
      +emojiGrid(view, shown)

  +screen(view, 'Editing a description', 'edit')
    +tdrFrame(view, 'Emojis', { bare: true })
      +emojiToolbar(view)
      +emojiGrid(view, phone ? some.slice(1, 3) : some, { editId: rows[1].id })

  +screen(view, 'Reconcile running · live badge, pending rows describing', 'running')
    +tdrFrame(view, 'Emojis', { bare: true })
      +emojiToolbar(view, { state: 'running' })
      +emojiGrid(view, phone ? running.slice(0, 2) : running, { reconciling: true })

  +screen(view, 'Re-describe · confirm', 'redescribe')
    +tdrFrame(view, 'Emojis', { bare: true, height: phone ? 700 : 560 })
      +emojiToolbar(view)
      +emojiGrid(view, some)
      +dialog({ title: copy.redescribe.title, confirm: copy.redescribe.confirm, cancel: copy.redescribe.cancel })
        p= copy.redescribe.lede
        div(class='mt-3 flex items-start gap-3 rounded-md border border-line bg-bg-sunk p-3')
          +emojiTile(rows[0])
          p(class='text-sm text-ink-2')= rows[0].desc

  +screen(view, 'Re-describe all · confirm', 'redescribe-all')
    +tdrFrame(view, 'Emojis', { bare: true, height: phone ? 700 : 560 })
      +emojiToolbar(view)
      +emojiGrid(view, some)
      +dialog({ title: copy.redescribeAll.title, confirm: copy.redescribeAll.confirm, cancel: copy.redescribeAll.cancel })
        p= copy.redescribeAll.lede
        +note('warn', copy.redescribeAll.warn)(class='mt-3')= copy.redescribeAll.warnBody

  +screen(view, 'No emojis synced yet', 'empty')
    +tdrFrame(view, 'Emojis', { bare: true })
      +emojiToolbar(view, { state: 'never', counts: { All: 0, 'Needs description': 0, AI: 0, Manual: 0, Deleted: 0 } })
      +listShell
        +emptyState(copy.empty.title, copy.empty.body, copy.empty.action)

  +screen(view, 'No matching emojis', 'filtered')
    +tdrFrame(view, 'Emojis', { bare: true })
      +emojiToolbar(view, { query: 'zzz' })
      +listShell
        +emptyState(copy.filtered.title, copy.filtered.body, 'Clear search')

  +screen(view, 'Loading', 'loading')
    +tdrFrame(view, 'Emojis', { bare: true })
      +emojiToolbar(view)
      +emojiSkeleton(view)

  +screen(view, 'Errors · dismissible, and the list failing to load', 'errors')
    +tdrFrame(view, 'Emojis', { bare: true })
      +dismissNote('bad', copy.reconcileError.lead)= copy.reconcileError.body
      +note('bad', copy.loadError.lead)= copy.loadError.body

block content
  +mockHead({ eyebrow: 'tdr-bot · emojis', title: 'Emojis', back: true })
    p The bot’s custom-emoji dictionary as a grid of cards: the image, the name in mono, where the description came from (AI, Manual, Deleted, or Pending while one is on its way) and the description itself, editable in place. Reconcile syncs the server’s emojis and shows a live badge while it runs.

  div(class='vp-scope flex flex-col items-center gap-6')
    +viewportToggle('emojis-viewport')
    +viewportPanel('desktop')
      +jumpNav(jump, 'desktop')(class='w-full')
      +emojiStates('desktop')
    +viewportPanel('mobile')
      +jumpNav(jump, 'mobile')(class='w-full')
      +emojiStates('mobile')
