extends ../../../../../designs/mockup-kit/page.pug

include ../mixins/tdr-bot.pug

block title
  | tdr-bot — Settings · UI mockups

//-
  Settings at 1280 and 390. One mixin draws every state at one viewport; the
  rows below are the states. Copy and sample data are in src/data/settings.mjs.

//- Everything the page shows at one viewport.
mixin settingsStates(view)
  - const phone = view === 'mobile'
  - const width = 'max-w-[720px]'

  +screen(view, 'Saved', 'default')
    +tdrFrame(view, 'Settings', { width: width })
      +pageHead(copy.title, copy.lede)
      +settingsForm(view, states.clean)

  +screen(view, 'Chat model · select open', 'open')
    +tdrFrame(view, 'Settings', { bare: true, width: width })
      +settingsForm(view, states.open)

  +screen(view, 'Unsaved changes', 'dirty')
    +tdrFrame(view, 'Settings', { bare: true, width: width })
      +settingsForm(view, states.dirty)

  +screen(view, 'Saving', 'saving')
    +tdrFrame(view, 'Settings', { bare: true, width: width })
      +settingsForm(view, states.saving)

  +screen(view, 'Saved just now', 'saved')
    +tdrFrame(view, 'Settings', { bare: true, width: width })
      +settingsForm(view, states.saved)

  +screen(view, 'Rejected model · field error', 'error-model')
    +tdrFrame(view, 'Settings', { bare: true, width: width })
      +settingsForm(view, states.errorModel)

  +screen(view, 'Prompt too long · field error', 'error-prompt')
    +tdrFrame(view, 'Settings', { bare: true, width: width })
      +settingsForm(view, states.errorPrompt)

  +screen(view, 'Reasoning model · effort instead of temperature', 'reasoning')
    +tdrFrame(view, 'Settings', { bare: true, width: width })
      +settingsForm(view, states.reasoning)

  +screen(view, 'Reset · confirm', 'reset')
    +tdrFrame(view, 'Settings', { bare: true, height: phone ? 640 : 560, width: width })
      +settingsForm(view, states.clean)
      +dialog({ title: copy.reset.title, confirm: copy.reset.confirm, cancel: copy.reset.cancel, destructive: true })
        = copy.reset.body

  +screen(view, 'Loading', 'loading')
    +tdrFrame(view, 'Settings', { width: width })
      +pageHead(copy.title, copy.lede)
      each title in ['Models', 'Generation', 'System prompt']
        +panel(title)
          +skeleton('lines')

  +screen(view, 'Load error', 'load-error')
    +tdrFrame(view, 'Settings', { width: width })
      +pageHead(copy.title, copy.lede)
      +note('bad', copy.loadError.lead)= copy.loadError.body

  if phone
    +screen(view, 'Phone · navigation sheet', 'nav')
      +tdrFrame(view, 'Settings', { height: 560, nav: true })
        +pageHead(copy.title, copy.lede)
        +settingsForm(view, states.clean)

  +stateRow('Toasts', { stack: true })(class='w-full' id='toasts-' + view)
    each t in toasts
      +toast(t.tone, t.title)

block content
  +mockHead({ eyebrow: 'tdr-bot · settings', title: 'Settings', back: true })
    p Models, generation and the system prompt the bot runs with. Three cards, a save row whose status line says what state the form is in, and a reset that confirms before it replaces anything. The chat model decides whether Generation shows a temperature slider or a reasoning-effort choice.

  div(class='vp-scope flex flex-col items-center gap-6')
    +viewportToggle('settings-viewport')
    +viewportPanel('desktop')
      +jumpNav(jump.filter(j => j[1] !== 'nav'), 'desktop')(class='w-full')
      +settingsStates('desktop')
    +viewportPanel('mobile')
      +jumpNav(jump, 'mobile')(class='w-full')
      +settingsStates('mobile')
