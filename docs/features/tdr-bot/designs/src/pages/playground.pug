extends ../../../../../designs/mockup-kit/page.pug

include ../mixins/tdr-bot.pug

block title
  | tdr-bot — Playground · UI mockups

//-
  The playground at 1280 and 390: an admin chat with the bot's chat model to
  check whether it reaches for the custom emojis, and the eval that runs every
  model over ten prompts. Copy and sample data are in src/data/playground.mjs.

mixin playgroundStates(view)
  - const phone = view === 'mobile'
  - const shown = phone ? turns.slice(-3) : turns

  +screen(view, 'Conversation', 'default')
    +tdrFrame(view, 'Playground')
      +pageHead('Playground', 'Chat with the bot’s model outside Discord and see which emojis it picks.')
      +playgroundToolbar(view)
      +playgroundThread(view, shown)
      +composer(view)

  +screen(view, 'Model select open', 'model')
    +tdrFrame(view, 'Playground', { bare: true, height: phone ? 560 : 440 })
      +playgroundToolbar(view, { modelOpen: true })

  +screen(view, 'System prompt draft · modified, collapsed', 'draft')
    +tdrFrame(view, 'Playground', { bare: true })
      +playgroundToolbar(view, { draft: 'dirty' })
      +playgroundThread(view, turns.slice(0, 2))

  +screen(view, 'System prompt draft · open', 'draft-open')
    +tdrFrame(view, 'Playground', { bare: true })
      +playgroundToolbar(view, { draft: 'open' })

  +screen(view, 'Reply pending', 'pending')
    +tdrFrame(view, 'Playground', { bare: true })
      +playgroundThread(view, [turns[0], turns[1], ...pendingTurns])
        +thinking('gpt-5-mini')
      +composer(view, '', true)

  +screen(view, 'Reply failed · Retry', 'failed')
    +tdrFrame(view, 'Playground', { bare: true })
      +playgroundThread(view, pendingTurns)
        +failedReply(view, 'gpt-5', copy.failed)
      +composer(view)

  +screen(view, 'Empty thread', 'empty')
    +tdrFrame(view, 'Playground', { bare: true })
      +playgroundToolbar(view)
      +listShell
        +emptyState(copy.empty.title, copy.empty.body)
      +composer(view)

  +screen(view, 'Eval · ready', 'eval')
    +tdrFrame(view, 'Playground', { bare: true })
      +evalPanel(view)

  +screen(view, 'Eval · running, cancel available', 'eval-running')
    +tdrFrame(view, 'Playground', { bare: true })
      +evalPanel(view, { state: 'running' })

  +screen(view, 'Eval · results, one row open', 'eval-done')
    +tdrFrame(view, 'Playground', { bare: true })
      +evalPanel(view, { state: 'done', open: 'gpt-5-mini' })

  +screen(view, 'Eval · error', 'eval-error')
    +tdrFrame(view, 'Playground', { bare: true })
      +note('bad', copy.evalError.lead)= copy.evalError.body
      +evalPanel(view, { state: 'done', open: 'gpt-5' })

  +screen(view, 'Reset conversation · confirm', 'reset')
    +tdrFrame(view, 'Playground', { bare: true, height: phone ? 640 : 520 })
      +playgroundToolbar(view)
      +playgroundThread(view, turns.slice(0, 2))
      +dialog({ title: 'Reset the conversation?', confirm: 'Reset conversation', cancel: 'Keep it', destructive: true })
        | The thread is cleared and the model starts fresh. The system prompt draft stays.

block content
  +mockHead({ eyebrow: 'tdr-bot · playground', title: 'Playground', back: true })
    p A chat with the bot’s model outside Discord, plus the emoji eval. Replies carry model, cost and latency, and badges for how many emojis came from the dictionary, were repaired, were invented or were plain Unicode. The eval table opens a row to show every reply behind it.

  div(class='vp-scope flex flex-col items-center gap-6')
    +viewportToggle('playground-viewport')
    +viewportPanel('desktop')
      +jumpNav(jump, 'desktop')(class='w-full')
      +playgroundStates('desktop')
    +viewportPanel('mobile')
      +jumpNav(jump, 'mobile')(class='w-full')
      +playgroundStates('mobile')
