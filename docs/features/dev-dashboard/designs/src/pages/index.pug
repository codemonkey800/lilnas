extends ../../../../../designs/mockup-kit/page.pug

include ../mixins/dev.pug

block title
  | dev — Overview · UI mockups

//-
  The overview: every compose stack on the dev host, as a card. Two sections —
  the lilnas apps (apps/*/deploy.dev.yml) and the projects under ~/dev. Same
  card for both; only the source badge differs. Copy and sample data are in
  src/data/index.mjs.

//- The whole screen, with the sample stacks: host strip, then the two groups.
mixin overview(view)
  - const mobile = view === 'mobile'
  +devFrame(view)
    div(class='mb-8')
      +hostStrip(mobile)
    div(class='mb-9')
      +stackSection('lilnas apps', 'apps/*/deploy.dev.yml', stacks.filter(s => s.group === 'apps'), mobile)
    +stackSection('~/dev projects', '~/dev/*/docker-compose*.yml', stacks.filter(s => s.group === 'dev'), mobile)

mixin states(view)
  - const mobile = view === 'mobile'
  - const width = mobile ? 'w-[390px]' : 'w-full'
  +jumpNav([['Loading', 'loading'], ['Nothing found', 'empty'], ['API error', 'error'], ['Empty group', 'group'], ['Card states', 'cards'], ['Actions', 'actions']], view)(class='mt-14 justify-center')

  +mockSection('loading-' + view, 'Loading', 'The first answer is on its way. Skeletons match the host strip and the cards, and the line says what is happening.')(class=width)
    +devFrame(view)
      +loadingOverview(mobile)

  +mockSection('empty-' + view, 'Nothing found', 'No lilnas app has a deploy.dev.yml and nothing under ~/dev has a compose file. Refresh is the one thing to press.')(class=width)
    +devFrame(view)
      +card()
        +emptyState('No dev stacks yet', 'Add a compose file under ~/dev, or a deploy.dev.yml to an app, and it’ll show up here, ready to bring up.', 'Refresh')

  +mockSection('error-' + view, 'The API didn’t answer', 'With a list already on screen the note sits above it and says it may be stale; on the first load there is nothing to show but the note.')(class=width)
    div(class='flex flex-col gap-6')
      +stateCell('Error above a stale list', { fill: true })
        +devFrame(view)
          +errorNote('Couldn’t load the stack list.', 'The dashboard’s API didn’t answer, so the stacks below may be stale.', mobile)(class='mb-8')
          div(class='mb-8')
            +hostStrip(mobile)
          +stackSection('lilnas apps', 'apps/*/deploy.dev.yml', stacks.filter(s => s.group === 'apps'), mobile)
      +stateCell('Error on the first load', { fill: true })
        +devFrame(view)
          +errorNote('Couldn’t load the stack list.', 'The dashboard’s API didn’t answer.', mobile)

  +mockSection('group-' + view, 'A group with nothing in it', 'The other group still lists its stacks; the empty one says why it is empty.')(class=width)
    +devFrame(view)
      +sectionHead('~/dev projects', '~/dev/*/docker-compose*.yml', 0)
      +card()(class='text-sm text-ink-3') No project under ~/dev has a docker-compose file.

  +mockSection('cards-' + view, 'One card per state', 'Running, Unhealthy, Exited, Absent, Busy and Env missing, each on its own sample stack. The overview above uses the same cards.')(class=width)
    +devFrame(view)
      +cardFlow(mobile)
        each slug in ['hop-road', 'fitness-pwa', 'test-landing-page', 'gooncut', 'blabla', 'tdr-bot']
          - const s = stacks.find(x => x.slug === slug)
          div(class='mb-4 break-inside-avoid')
            +stackCard(s, mobile)

  +mockSection('actions-' + view, 'The action row, mid-flow', 'Recreate and Down ask first and keep the verb they were pressed with; the API can refuse with 409 or 412, or fail.')(class=width)
    +devFrame(view)
      +cardFlow(mobile)
        each st in actionStates
          div(class='mb-4 break-inside-avoid')
            p(class='mb-1.5 text-label text-ink-3 uppercase')= st.label
            +stackCard(st.stack, mobile)

block content
  +mockHead({ back: false, eyebrow: 'dev · compact', title: 'Overview' })
    p Every compose stack on the dev host, in two groups: the lilnas apps and the projects under ~/dev. Each card shows its routes, its containers and when the idle reaper will take them. Open any card for the #[a(class='text-accent-hi hover:underline' href='stack-detail.html') stack detail] page.

  div(class='vp-scope')
    +viewportToggle('viewport')(class='mb-8' role='radiogroup' aria-label='Viewport')

    +viewportPanel('desktop')
      +overview('desktop')
      +states('desktop')

    +viewportPanel('mobile')
      +overview('mobile')
      +states('mobile')
