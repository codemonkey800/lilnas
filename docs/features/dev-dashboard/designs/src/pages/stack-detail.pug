extends ../../../../../designs/mockup-kit/page.pug

include ../mixins/dev.pug

block title
  | dev — Stack detail · UI mockups

//-
  One stack, in full: what's running, which env files it needs, when the
  reaper will take it, what the last operation printed, and its container
  logs. The stack is fitness-pwa — the busiest card on the overview. Copy and
  sample data are in src/data/stack-detail.mjs.

mixin detail(view)
  - const mobile = view === 'mobile'
  +devFrame(view)
    div(class='flex flex-col gap-5')
      +stackHeader(mobile)
      +servicesPanel(services, view)
      div(class=['grid gap-5', mobile ? 'grid-cols-1' : 'grid-cols-2'])
        +envFilesPanel(envFiles)
        +reaperPanel()
      +opLog(operations.done)
      +containerLogs({ mobile: mobile })

mixin states(view)
  - const mobile = view === 'mobile'
  - const width = mobile ? 'w-[390px]' : 'w-full'
  - const pair = mobile ? 'grid grid-cols-1 gap-5' : 'grid grid-cols-2 gap-5'
  +jumpNav([['Services', 'services'], ['Env files', 'env'], ['Idle reaper', 'reaper'], ['Operation log', 'oplog'], ['Container logs', 'logs'], ['Status line', 'status'], ['Page states', 'page']], view)(class='mt-14 justify-center')

  +mockSection('services-' + view, 'Services with no containers', 'A reaped or downed stack: every service reads “not created”.')(class=width)
    +devFrame(view)
      +servicesPanel(absentServices, view)

  +mockSection('env-' + view, 'Env files', 'A required file missing is red; an optional one is quiet. A compose file can also name none.')(class=width)
    +devFrame(view)
      div(class=pair)
        +stateCell('Required file missing', { fill: true })
          +envFilesPanel([{ path: '.env', present: false, required: true }, { path: '.env.local', present: true, required: false }])
        +stateCell('No env files', { fill: true })
          +envFilesPanel([])

  +mockSection('reaper-' + view, 'Idle reaper', 'Counting down is the default. While someone is active there is no reap time; an exempt stack is never stopped.')(class=width)
    +devFrame(view)
      div(class=pair)
        +stateCell('Kept by active users', { fill: true })
          +reaperPanel('kept')
        +stateCell('Exempt', { fill: true })
          +reaperPanel('off')

  +mockSection('oplog-' + view, 'Operation log', 'The same panel while the operation streams, and after it fails.')(class=width)
    +devFrame(view)
      div(class=pair)
        +stateCell('While an operation runs', { fill: true })
          +opLog(operations.running)
        +stateCell('Failed', { fill: true })
          +opLog(operations.failed)

  +mockSection('logs-' + view, 'Container logs', 'Empties say what happened and what to do; none of them is a blank pane.')(class=width)
    +devFrame(view)
      div(class=pair)
        +stateCell('No containers yet', { fill: true })
          +containerLogs({ mobile: mobile, empty: 'containers' })
        +stateCell('Filter matches nothing', { fill: true })
          +containerLogs({ mobile: mobile, empty: 'match', filter: 'timeout' })
        +stateCell('No output yet', { fill: true })
          +containerLogs({ mobile: mobile, empty: 'output', status: 'live' })
        +stateCell('Connecting', { fill: true })
          +containerLogs({ mobile: mobile, status: 'connecting', lines: [] })

  +mockSection('status-' + view, 'Status line', 'Beside the heading. Only a live follow pulses; a dropped stream is amber and says it is retrying.')(class=width)
    +devFrame(view)
      div(class='flex flex-col gap-5')
        +stateRow('Connecting', { stack: true })
          +containerLogs({ mobile: mobile, status: 'connecting', lines: [], tail: 100 })(class='w-full')
        +stateRow('Paused', { stack: true })
          +containerLogs({ mobile: mobile, status: 'paused', follow: false, timestamps: false, lines: logs.slice(0, 6) })(class='w-full')
        +stateRow('Reconnecting', { stack: true })
          +containerLogs({ mobile: mobile, status: 'reconnecting', lines: logs.slice(0, 4), tail: 2000 })(class='w-full')
        +stateRow('Ended', { stack: true })
          +containerLogs({ mobile: mobile, status: 'ended', lines: logs.slice(8) })(class='w-full')

  +mockSection('page-' + view, 'The page itself', 'Loading, a stack that does not exist, and the API not answering.')(class=width)
    div(class='flex flex-col gap-6')
      +stateCell('Loading', { fill: true })
        +devFrame(view)
          +loadingDetail
      +stateCell('No such stack (404)', { fill: true })
        +devFrame(view)
          +notFound(notFoundId, mobile)
      +stateCell('Error above a stale page', { fill: true })
        +devFrame(view)
          +errorNote('Couldn’t load this stack.', 'The dashboard’s API didn’t answer, so what’s below may be stale.', mobile)(class='mb-5')
          +stackHeader(mobile)
      +stateCell('Error on the first load', { fill: true })
        +devFrame(view)
          +errorNote('Couldn’t load this stack.', 'The dashboard’s API didn’t answer.', mobile)

block content
  +mockHead({ back: 'index.html', backLabel: 'Overview', eyebrow: 'dev · compact', title: 'Stack detail' })
    p One stack in full: its containers, env files, idle-reaper clock, the last operation’s output and a live container log. Shown for fitness-pwa — two routes, one of them open, and an api container failing its healthcheck.

  div(class='vp-scope')
    +viewportToggle('viewport')(class='mb-8' role='radiogroup' aria-label='Viewport')

    +viewportPanel('desktop')
      +detail('desktop')
      +states('desktop')

    +viewportPanel('mobile')
      +detail('mobile')
      +states('mobile')
