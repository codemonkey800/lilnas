//-
  The mockup harness — the furniture around a screen, not part of the screen.

  Every mockup page is: a header explaining what you're looking at, then the
  screen itself drawn twice (desktop and mobile) behind a segmented control.
  None of this exists in the real app.

include ui.pug

//- Page header: back link, eyebrow, title, standfirst.
mixin mockHead(opts)
  - opts = opts || {}
  header(class='mb-11 max-w-[74ch] reveal')&attributes(attributes)
    if opts.back !== false
      a(
        class='mb-[22px] inline-flex items-center gap-1.5 text-sm text-ink-3 hover:text-ink'
        href=opts.back || 'index.html'
      )
        +icon('arrow')(class='h-3 w-3 -scale-x-100 text-ink-4')
        = opts.backLabel || 'All mockups'
    if opts.eyebrow
      p(class='mb-2.5 font-mono text-label tracking-[0.11em] uppercase text-uv')= opts.eyebrow
    h1(class='mb-3 text-[30px] leading-[1.25] font-[650] tracking-[-0.015em]')= opts.title
    block

//- Inline code, for prose that names a file or a class.
mixin code(text)
  code(class='rounded-sm bg-surface-2 px-[5px] py-px font-mono text-[0.92em]')&attributes(attributes)= text

//- A fixed-height stage to demonstrate something absolutely positioned inside.
mixin demoFrame
  div(class='relative h-[260px] overflow-hidden rounded-lg border border-line bg-bg-sunk')&attributes(attributes)
    block

//-
  Desktop/mobile switch.

  A pair of hidden radios in labels, read by `.vp-scope:has(...)` in
  theme.css. No JS: these files are opened through wrappers (iframe srcdoc
  among them) where a page's own <script> is inert, and the switch is the one
  control that has to work everywhere.

  `name` must be unique per switch on the page — that's what groups the two
  radios and what the panels below key off.
mixin viewportToggle(name, opts)
  - opts = opts || {}
  -
    const views = [
      { value: 'desktop', label: 'Desktop', hint: '1280' },
      { value: 'mobile', label: 'Mobile', hint: '390' },
    ]
  div(class='inline-flex gap-1 rounded-full border border-line bg-surface p-1')&attributes(attributes)
    each view in views
      label(
        class='inline-flex h-8 cursor-pointer items-center gap-[7px] rounded-full px-[15px] text-[13px] font-[550] text-ink-3 transition-[background-color,color] duration-200 ease-uv hover:text-ink has-[:checked]:bg-uv has-[:checked]:font-[620] has-[:checked]:text-uv-ink has-[:checked]:hover:bg-uv-hi has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-uv'
      )
        input(
          class='vp-radio pointer-events-none absolute m-0 h-0 w-0 opacity-0'
          type='radio'
          name=name
          value=view.value
          checked=view.value === (opts.default || 'desktop')
        )
        = view.label
        span(class='font-mono text-[10.5px] text-ink-4 group-has-[:checked]:text-uv-ink')= view.hint

//-
  One viewport's panel. Shown only when the matching radio in the enclosing
  `.vp-scope` is checked. Wrap a pair of these plus a +viewportToggle in
  `div(class='vp-scope')`.
mixin viewportPanel(view)
  div(class='w-full flex-col items-center gap-4' data-viewport-panel=view)&attributes(attributes)
    block

//- Caption under a framed screen.
mixin frameLabel
  p(class='block text-center font-mono text-label tracking-[0.11em] uppercase text-ink-4')&attributes(attributes)
    block

//-
  The app chrome a screen is drawn inside — rounded window, top bar, body.
  Width comes from the viewport it's being shown at.
    view  'desktop' (1280px) | 'mobile' (390px)
    crop  fade the bottom off at a fixed height, for screens that are only
          being shown from the top
    tall  with `crop`, a taller crop — for a modal too long for the default
          height to show whole
mixin appFrame(view, opts)
  - opts = opts || {}
  - const mobile = view === 'mobile'
  - const cropHeight = opts.tall ? (mobile ? 'h-[900px]' : 'h-[720px]') : mobile ? 'h-[460px]' : 'h-[440px]'
  div(
    class=[
      'relative max-w-full overflow-hidden rounded-xl border border-line bg-bg',
      mobile ? 'w-[390px]' : 'w-[1280px]',
      opts.crop ? ['flex flex-col', cropHeight] : '',
    ]
  )&attributes(attributes)
    block

//- The app's top bar: doorplate on the left, search and account on the right.
mixin appBar(view)
  - const mobile = view === 'mobile'
  div(
    class=[
      'flex shrink-0 items-center justify-between gap-3 border-b border-line-soft bg-bg-sunk',
      mobile ? 'py-2.5 pr-[14px] pl-4' : 'px-4 py-[11px]',
    ]
  )&attributes(attributes)
    block

//- The app's content area. `crop` fades its bottom off; `tall` (see
    +appFrame) starts that fade later, so a long modal centred in it stays
    clear of the fade.
mixin appBody(view, opts)
  - opts = opts || {}
  - const mobile = view === 'mobile'
  div(
    class=[
      mobile ? 'px-6 pt-[18px] pb-[30px]' : 'px-8 pt-[30px] pb-11',
      opts.crop
        ? [
            'relative flex-1 overflow-hidden',
            opts.tall
              ? '[mask-image:linear-gradient(180deg,#000_90%,transparent)]'
              : '[mask-image:linear-gradient(180deg,#000_78%,transparent)]',
          ]
        : '',
    ]
  )&attributes(attributes)
    block
