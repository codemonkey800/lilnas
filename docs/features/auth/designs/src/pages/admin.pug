extends ../../../../../designs/mockup-kit/page.pug

include ../mixins/auth.pug

block title
  | auth — Admin · UI mockups

//-
  The admin dashboard at 1280 and 390. Every screen is drawn by one mixin per
  viewport; the rows below are the states. Copy and sample data are in
  src/data/admin.mjs.

//- One state row at one viewport: the caption above a framed screen.
mixin screen(view, label, anchor)
  +stateRow(label, { stack: true })(class='w-full' id=anchor + '-' + view)
    div(class=['flex w-full flex-col gap-2', view === 'mobile' ? 'items-center' : ''])
      block
      +frameLabel= view === 'mobile' ? 'Mobile · 390' : 'Desktop · 1280'

//- Everything the page shows at one viewport.
mixin adminStates(view)
  - const phone = view === 'mobile'
  - const dlgH = phone ? 960 : 920
  - const addH = phone ? 1000 : 800
  - const cfmH = phone ? 640 : 500

  +screen(view, 'Default', 'default')
    +adminShell(view)
      +adminTitle
      +statTiles(stats)
      +requestsSection(view, requests)
      +peopleSection(view, peopleCols, people)
      +discordSection(view, discordData)
      +blockedSection(view, blockedCols, blocked)

  +screen(view, 'Nothing pending', 'quiet')
    +adminShell(view, { bare: true })
      +statTiles(statsQuiet)
      +requestsSection(view, requests, { empty: true })

  +screen(view, 'Requests · two selected', 'selected')
    +adminShell(view, { bare: true })
      +requestsSection(view, requests, { selected: [0, 1] })

  +screen(view, 'People · search finds nothing', 'filtered')
    +adminShell(view, { bare: true })
      +peopleSection(view, peopleCols, [], { query: 'zed', count: 0 })

  +screen(view, 'Action failed', 'failed')
    +adminShell(view, { bare: true })
      +note('bad', actionError.lead)= actionError.body
      +peopleSection(view, peopleCols, people.slice(1, 3))

  +screen(view, 'Discord links · nothing to link', 'discord-empty')
    +adminShell(view, { bare: true })
      +discordSection(view, discordData, { empty: true })

  +screen(view, 'Blocked · empty', 'blocked-empty')
    +adminShell(view, { bare: true })
      +blockedSection(view, blockedCols, [])

  +screen(view, 'Add person', 'add')
    +adminShell(view, { height: addH })
      +peopleSection(view, peopleCols, people)
      +addPersonDialog(dialogData, { view: view, email: 'sam.rivera@example.com', checked: [serviceList[0].host, serviceList[4].host], rules: ['*.dev.lilnas.io'] })

  +screen(view, 'Add person · bad email', 'add-error')
    +adminShell(view, { height: addH })
      +peopleSection(view, peopleCols, people)
      +addPersonDialog(dialogData, { view: view, email: 'sam.rivera@', error: true })

  +screen(view, 'Edit access', 'edit')
    +adminShell(view, { height: dlgH })
      +peopleSection(view, peopleCols, people)
      +editAccessDialog(dialogData, { view: view })

  +screen(view, 'Block · confirm', 'block')
    +adminShell(view, { height: cfmH })
      +peopleSection(view, peopleCols, people)
      +confirmDialog(confirms.block)

  +stateRow('Other confirms', { stack: true })(class='w-full' id='confirms-' + view)
    each key in ['blockAdmin', 'remove', 'signOut', 'unlink']
      +stateCell(confirms[key].title)
        +demoFrame(phone ? 290 : 250)(class='w-[490px] max-w-full')
          +confirmDialog(confirms[key])

  +screen(view, 'Error boundary', 'error')
    +gate(view)
      +gateHeading(errorBoundary.heading)
      +note('bad', errorBoundary.lead)
        | #{errorBoundary.body}#{' '}
        +code(errorBoundary.code)
      +btn({ variant: 'accent', size: 'lg', full: true, icon: 'refresh', label: errorBoundary.action })

  +stateRow('Toasts', { stack: true })(class='w-full' id='toasts-' + view)
    each t in toasts
      +toast(t.tone, t.title)

block content
  +mockHead({ eyebrow: 'auth · admin', title: 'Admin', back: true })
    p Access control: who’s asking, who has what, and who is blocked. People render as a table at 1280 and a card list at 390 from one column definition. Destructive actions confirm in a dialog that names the person and what they lose, and the confirm button is the filled red one.

  div(class='vp-scope flex flex-col items-center gap-6')
    +viewportToggle('admin-viewport')
    +viewportPanel('desktop')
      +jumpNav(jump, 'desktop')(class='w-full')
      +adminStates('desktop')
    +viewportPanel('mobile')
      +jumpNav(jump, 'mobile')(class='w-full')
      +adminStates('mobile')
