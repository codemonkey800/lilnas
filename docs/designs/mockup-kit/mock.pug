//-
  The mockup harness — the furniture around a screen, not part of the screen.

  Every mockup page is: a header explaining what you're looking at, then the
  screen drawn at desktop and mobile width behind a segmented control, with its
  states shown side by side. None of this exists in the real app.

  Ported from the download project's Ultraviolet harness. The switch is still
  CSS-only (hidden radios read with `:has()`): these files get opened through
  wrappers (iframe srcdoc among them) where a page's own <script> never runs,
  so there is no behavioural JS anywhere in the kit.

include ui.pug

//- Page header: back link, eyebrow, title, standfirst (the block).
mixin mockHead(opts)
  - opts = opts || {}
  header(class='reveal mb-10 max-w-[74ch]')&attributes(attributes)
    if opts.back
      a(
        class='mb-5 inline-flex items-center gap-1.5 text-sm text-ink-3 hover:text-ink'
        href=opts.back === true ? 'index.html' : opts.back
      )
        +icon('arrow', 12)(class='-scale-x-100 text-ink-4')
        = opts.backLabel || 'All mockups'
    if opts.eyebrow
      p(class='mb-2 font-mono text-label tracking-[0.06em] text-accent-hi uppercase')= opts.eyebrow
    h1(class='mb-3 text-h1')= opts.title
    div(class='text-body text-ink-2')
      block

//- A titled section of a page, with an anchor for jumpNav and a one-line lede.
mixin mockSection(id, title, lede)
  section(class='mt-14 scroll-mt-6' id=id)&attributes(attributes)
    h2(class='text-h2')= title
    if lede
      p(class='mt-1 max-w-[74ch] text-sm text-ink-3')= lede
    div(class='mt-5')
      block

//-
  One Nexus review frame: a direct child of the `.page` column. Nexus reads
  `section.sec` children of the first `.page` element as frames and the h2 as
  the frame's title, so the section carries its own title and caption and
  depends on nothing outside it. `sec`, `sec-title` and `sec-num` are marker
  classes only. See "Nexus review frames" in the kit README.
    id    the section id (an anchor)         title  the frame title (h2)
    opts  num      a number such as '01'     caption  one line under the title
mixin mockFrame(id, title, opts)
  - opts = opts || {}
  section(class='sec mb-14 scroll-mt-6 last:mb-0' id=id)&attributes(attributes)
    header(class='mb-5 max-w-[74ch]')
      div(class='flex items-baseline gap-3')
        if opts.num
          span(class='sec-num font-mono text-label tracking-[0.06em] text-ink-4')= opts.num
        h2(class='sec-title text-h2')= title
      if opts.caption
        p(class='mt-1 text-sm text-ink-3')= opts.caption
    block

//- Inline code, for prose that names a file or a class.
mixin code(text)
  code(class='rounded-xs bg-surface-2 px-1 py-px font-mono text-[0.92em] text-ink-2')&attributes(attributes)= text

//- A fixed-height stage for something absolutely positioned (dialog, sheet).
mixin demoFrame(height)
  div(
    class='relative overflow-hidden rounded-lg border border-line bg-bg-sunk'
    style=`height: ${height || 260}px`
  )&attributes(attributes)
    block

//-
  A captioned row showing one state of a screen or component: the caption
  (mono, uppercase) beside whatever the block draws. `stack` puts the caption
  above instead, for content too wide to share the row.
mixin stateRow(label, opts)
  - opts = opts || {}
  div(
    class=[
      'grid gap-x-6 gap-y-2 border-t border-line-soft py-4 first:border-t-0 first:pt-0',
      opts.stack ? 'grid-cols-1' : 'grid-cols-1 sm:grid-cols-[140px_minmax(0,1fr)]',
    ]
  )&attributes(attributes)
    p(class='pt-1.5 font-mono text-label tracking-[0.06em] text-ink-3 uppercase')= label
    div(class='flex min-w-0 flex-wrap items-start gap-x-4 gap-y-3')
      block

//-
  One captioned example inside a stateRow: the state's name above the thing.
  `fill` stretches the example to the cell's full width (a progress bar).
mixin stateCell(label, opts)
  - opts = opts || {}
  div(class=['flex flex-col gap-1.5', opts.fill ? 'w-full items-stretch' : 'items-start'])&attributes(attributes)
    span(class='text-cap text-ink-3')= label
    block

//-
  Desktop/mobile switch. A pair of hidden radios in labels, read by
  `.vp-scope:has(...)` in theme.css. `name` must be unique per switch on the
  page — it's what groups the two radios.
mixin viewportToggle(name, opts)
  - opts = opts || {}
  -
    const views = [
      { value: 'desktop', label: 'Desktop', hint: '1280' },
      { value: 'mobile', label: 'Mobile', hint: '390' },
    ]
  div(class='inline-flex gap-1 rounded-full border border-line bg-surface p-1')&attributes(attributes)
    each view in views
      label(
        class='group inline-flex h-8 cursor-pointer items-center gap-[7px] rounded-full px-[15px] text-sm font-medium text-ink-3 transition-[background-color,color] duration-200 ease-standard hover:text-ink has-[:checked]:bg-accent has-[:checked]:text-accent-ink has-[:checked]:hover:bg-accent-hi has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-accent'
      )
        input(
          class='vp-radio pointer-events-none absolute m-0 size-0 opacity-0'
          type='radio'
          name=name
          value=view.value
          checked=view.value === (opts.default || 'desktop')
        )
        = view.label
        span(class='font-mono text-label tracking-normal text-ink-4 group-has-[:checked]:text-accent-ink')= view.hint

//-
  One viewport's panel. Shown only when the matching radio in the enclosing
  `.vp-scope` is checked. Wrap a pair of these plus a +viewportToggle in
  `div(class='vp-scope')`.
mixin viewportPanel(view)
  div(class='w-full flex-col items-center gap-4' data-viewport-panel=view)&attributes(attributes)
    block

//- Caption under a framed screen.
mixin frameLabel
  p(class='block text-center font-mono text-label tracking-[0.06em] text-ink-4 uppercase')&attributes(attributes)
    block

//-
  The window a screen is drawn inside. Width comes from the viewport it's being
  shown at; it's `relative`, so a Dialog or Sheet can fill it.
    view  'desktop' (1280px) | 'mobile' (390px)
    opts  height  fixed height in px; the body clips          density  'compact'
mixin appFrame(view, opts)
  - opts = opts || {}
  - const mobile = view === 'mobile' || view === 'phone'
  div(
    data-density=opts.density || 'comfortable'
    class=[
      'relative flex max-w-full flex-col overflow-hidden rounded-xl border border-line bg-bg',
      mobile ? 'w-[390px]' : 'w-[1280px]',
      opts.density === 'compact' ? 'text-sm' : 'text-body',
    ]
    style=opts.height ? `height: ${opts.height}px` : undefined
  )&attributes(attributes)
    block

//-
  Jump links, so a page's stacked sections stay navigable. `items` is an array
  of [label, anchor-id] pairs.
mixin jumpNav(items, suffix)
  nav(class='flex flex-wrap gap-2' aria-label='Jump to section')&attributes(attributes)
    each item in items
      a(
        class='inline-flex h-6 items-center rounded-full border border-line bg-surface-2 px-2.5 font-mono text-mono-sm text-ink-3 transition-colors duration-200 ease-standard hover:text-ink'
        href=`#${item[1]}${suffix ? '-' + suffix : ''}`
      )= item[0]
