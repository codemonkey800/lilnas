{
  "name": "@lilnas/cli",
  "version": "0.2.0",
  "description": "Lil Nas CLI for managing monorepo services",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@12.14.0",
  "prettier": "@lilnas/prettier",
  "bin": {
    "lilnas": "./bin/run.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "clean": "rm -rf dist/ .turbo/ tsconfig.tsbuildinfo",
    "lint": "run-p -l 'lint:!(fix)'",
    "lint:eslint": "eslint src",
    "lint:prettier": "prettier -c src",
    "lint:fix": "run-p -l lint:*:fix",
    "lint:eslint:fix": "eslint --fix src",
    "lint:prettier:fix": "prettier -w src",
    "type-check": "tsc7 --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@oclif/core": "^4.8.4",
    "@tailwindcss/postcss": "4.3.3",
    "dotenv": "^16.0.0",
    "js-yaml": "^4.1.1",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "pug": "3.0.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@lilnas/eslint": "workspace:*",
    "@lilnas/prettier": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/pug": "2.0.10",
    "jest": "30.5.2",
    "npm-run-all": "4.1.5",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  },
  "oclif": {
    "bin": "lilnas",
    "dirname": "lilnas",
    "commands": {
      "strategy": "pattern",
      "target": "./src/commands"
    },
    "additionalHelpFlags": [
      "-h"
    ],
    "topicSeparator": " ",
    "topics": {
      "ci": {
        "description": "Helpers for the push-to-deploy GitHub Actions workflow"
      },
      "mockups": {
        "description": "Build the UI mockups under docs/features/*/designs"
      },
      "remote": {
        "description": "Manage services on the remote server"
      },
      "secrets": {
        "description": "Decrypt and verify the committed dotenvx env files (apps/*/.env.prod, infra/.env*). Guard against committing plaintext with: pnpm exec dotenvx ext precommit --install"
      }
    }
  },
  "files": [
    "bin",
    "completions",
    "dist",
    "src"
  ]
}
