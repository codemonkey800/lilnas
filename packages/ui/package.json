{
  "name": "@lilnas/ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "prettier": "@lilnas/prettier",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css"
  },
  "files": [
    "dist",
    "theme.css"
  ],
  "scripts": {
    "build": "tsc -p .",
    "clean": "rm -rf dist/ .turbo/",
    "lint": "run-p -l 'lint:!(fix)'",
    "lint:eslint": "eslint src",
    "lint:prettier": "prettier -c src theme.css",
    "lint:fix": "run-p -l lint:*:fix",
    "lint:eslint:fix": "eslint --fix src",
    "lint:prettier:fix": "prettier -w src theme.css",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --watch",
    "type-check": "tsc7 --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@lilnas/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@lilnas/eslint": "workspace:*",
    "@lilnas/tsc7": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3"
  }
}
