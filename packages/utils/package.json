{
  "name": "@lilnas/utils",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "prettier": "@lilnas/prettier",
  "exports": {
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "clean": "rm -rf dist/ .turbo/",
    "lint": "run-p -l 'lint:!(fix)'",
    "lint:eslint": "eslint src",
    "lint:prettier": "prettier -c src",
    "lint:fix": "run-p -l lint:*:fix",
    "lint:eslint:fix": "eslint --fix src",
    "lint:prettier:fix": "prettier -w src",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --watch",
    "type-check": "tsc7 --noEmit"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@prometheus-io/client": "^0.16.0",
    "rxjs": ">=7"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@prometheus-io/client": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "12.2.0",
    "@prometheus-io/client": "0.16.1",
    "@types/jest": "30.0.0",
    "@types/ws": "8.18.2",
    "jest": "30.5.2",
    "rxjs": "7.8.2",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "ws": "8.22.0"
  }
}
