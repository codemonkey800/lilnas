{
  "name": "@lilnas/utils",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "prettier": "@lilnas/prettier",
  "exports": {
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "clean": "rm -rf dist/ .turbo/",
    "lint": "run-p -l 'lint:!(fix)'",
    "lint:eslint": "eslint src",
    "lint:prettier": "prettier -c src",
    "lint:fix": "run-p -l lint:*:fix",
    "lint:eslint:fix": "eslint --fix src",
    "lint:prettier:fix": "prettier -w src",
    "test": "jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "prom-client": ">=15",
    "rxjs": ">=7"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "prom-client": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "11.1.6",
    "@types/jest": "30.0.0",
    "@types/ws": "8.18.2",
    "jest": "30.5.2",
    "prom-client": "15.1.3",
    "rxjs": "7.8.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3",
    "ws": "8.22.0"
  }
}
