{
  "name": "lilnas",
  "version": "0.2.0",
  "packageManager": "pnpm@12.14.0",
  "prettier": "@lilnas/prettier",
  "scripts": {
    "build": "dotenv -e .env.turbo -- turbo run build mockups",
    "clean": "rm -rf .turbo/{cache,cookies} docs/features/*/designs/.build && pnpm run -r clean",
    "clean:modules": "rm -rf node_modules packages/*/node_modules apps/*/node_modules",
    "lint": "dotenv -e .env.turbo -- turbo run lint mockups:lint",
    "lint:fix": "pnpm run -r lint:fix && pnpm run mockups:lint:fix",
    "mockups": "lilnas mockups build --all",
    "mockups:watch": "lilnas mockups build --all --watch",
    "mockups:lint": "prettier -c \"docs/features/*/designs/src/**/*.{mjs,js,css,html}\"",
    "mockups:lint:fix": "prettier -w \"docs/features/*/designs/src/**/*.{mjs,js,css,html}\"",
    "test": "dotenv -e .env.turbo -- turbo run test",
    "test:watch": "pnpm run --recursive --if-present test:watch",
    "type-check": "dotenv -e .env.turbo -- turbo run type-check"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.38.1",
    "@lilnas/cli": "workspace:*",
    "@lilnas/eslint": "workspace:*",
    "@lilnas/prettier": "workspace:*",
    "@lilnas/tsc7": "workspace:*",
    "@nestjs/cli": "11.0.10",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/testing": "11.1.6",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.18",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "5.0.6",
    "@types/fs-extra": "11.0.4",
    "@types/jest": "30.0.0",
    "@types/json-schema": "7.0.15",
    "@types/lodash": "4.17.26",
    "@types/mdast": "4.0.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@types/source-map-support": "0.5.10",
    "@types/uuid": "10.0.0",
    "@types/wicg-file-system-access": "2023.10.7",
    "@vitejs/plugin-react-swc": "4.3.3",
    "autoprefixer": "10.6.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "jest-environment-node": "30.5.2",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "pino": "^10.4.0",
    "pino-pretty": "13.2.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-tsconfig-paths": "6.1.1",
    "zx": "8.8.5"
  }
}
